<UserControl x:Class="DeskPilot.Admin.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Background="Transparent">

    <UserControl.Resources>
        <!-- Style cho 4 thẻ gợi ý câu hỏi (Prompt Cards) -->
        <Style x:Key="PromptCardButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#f3f4f6"/>
            <Setter Property="BorderBrush" Value="#e5e7eb"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="6,0"/>
            <Setter Property="Padding" Value="18,16,18,16"/>
            <Setter Property="MinHeight" Value="136"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="cardBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="18" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="cardBorder" Property="Background" Value="#ffffff"/>
                                <Setter TargetName="cardBorder" Property="BorderBrush" Value="#cbd5e1"/>
                                <Setter TargetName="cardBorder" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.08" Color="#0f172a" Direction="270"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="cardBorder" Property="Background" Value="#f1f5f9"/>
                                <Setter TargetName="cardBorder" Property="BorderBrush" Value="#94a3b8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style nút hành động nhẹ (Attachment, Image, Refresh) -->
        <Style x:Key="SubtleActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Foreground" Value="#64748b"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#f1f5f9"/>
                                <Setter Property="Foreground" Value="#1e293b"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- ================= 1. GIAO DIỆN CHÀO MỪNG LẦN ĐẦU TIÊN (LANDING SCREEN) ================= -->
        <ScrollViewer x:Name="LandingContainer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid HorizontalAlignment="Center" MaxWidth="920" Margin="20,40,20,40">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Tiêu đề lời chào -->
                    <RowDefinition Height="Auto"/> <!-- Dòng phụ -->
                    <RowDefinition Height="Auto"/> <!-- 4 Card gợi ý -->
                    <RowDefinition Height="Auto"/> <!-- Nút Refresh Prompts -->
                    <RowDefinition Height="Auto"/> <!-- Khung nhập Prompt chính -->
                </Grid.RowDefinitions>

                <!-- 1.1 TIÊU ĐỀ LỜI CHÀO "Hi there, John / What would like to know?" -->
                <StackPanel Grid.Row="0" Margin="0,0,0,8">
                    <!-- Dòng 1: Hi there, John -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="Hi there, " FontSize="38" FontWeight="Bold" Foreground="#111827" FontFamily="Segoe UI, Inter"/>
                        <TextBlock Text="John" FontSize="38" FontWeight="Bold" FontFamily="Segoe UI, Inter">
                            <TextBlock.Foreground>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#8b5cf6" Offset="0.0"/>
                                    <GradientStop Color="#a855f7" Offset="0.5"/>
                                    <GradientStop Color="#c084fc" Offset="1.0"/>
                                </LinearGradientBrush>
                            </TextBlock.Foreground>
                        </TextBlock>
                    </StackPanel>

                    <!-- Dòng 2: What would like to know? -->
                    <TextBlock Text="What would like to know?" FontSize="38" FontWeight="Bold" FontFamily="Segoe UI, Inter">
                        <TextBlock.Foreground>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#1e1b4b" Offset="0.0"/>
                                <GradientStop Color="#4338ca" Offset="0.45"/>
                                <GradientStop Color="#6366f1" Offset="1.0"/>
                            </LinearGradientBrush>
                        </TextBlock.Foreground>
                    </TextBlock>
                </StackPanel>

                <!-- 1.2 DÒNG PHỤ HƯỚNG DẪN -->
                <TextBlock Grid.Row="1" 
                           Text="Use one of the most common prompts below or use your own to begin"
                           FontSize="14" Foreground="#9ca3af" Margin="0,0,0,28" FontFamily="Segoe UI, Inter"/>

                <!-- 1.3 4 THẺ GỢI Ý CÂU HỎI (PROMPT CARDS) -->
                <Grid Grid.Row="2" Margin="-6,0,-6,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Card 1 -->
                    <Button Grid.Column="0" Style="{StaticResource PromptCardButtonStyle}" Click="PromptCard_Click" Tag="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="TxtPrompt1" Grid.Row="0"
                                       Text="Write a to-do list for a personal project or task"
                                       TextWrapping="Wrap" FontSize="13" FontWeight="SemiBold" 
                                       Foreground="#1f2937" LineHeight="19"/>
                            <!-- Icon Person / User -->
                            <Path Grid.Row="1" Width="18" Height="18" Stretch="Uniform" Fill="#64748b" HorizontalAlignment="Left" Margin="0,16,0,0"
                                  Data="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                        </Grid>
                    </Button>

                    <!-- Card 2 -->
                    <Button Grid.Column="1" Style="{StaticResource PromptCardButtonStyle}" Click="PromptCard_Click" Tag="2">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="TxtPrompt2" Grid.Row="0"
                                       Text="Generate an email to reply to a job offer"
                                       TextWrapping="Wrap" FontSize="13" FontWeight="SemiBold" 
                                       Foreground="#1f2937" LineHeight="19"/>
                            <!-- Icon Mail / Envelope -->
                            <Path Grid.Row="1" Width="18" Height="18" Stretch="Uniform" Fill="#64748b" HorizontalAlignment="Left" Margin="0,16,0,0"
                                  Data="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
                        </Grid>
                    </Button>

                    <!-- Card 3 -->
                    <Button Grid.Column="2" Style="{StaticResource PromptCardButtonStyle}" Click="PromptCard_Click" Tag="3">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="TxtPrompt3" Grid.Row="0"
                                       Text="Summarise this article or text for me in one paragraph"
                                       TextWrapping="Wrap" FontSize="13" FontWeight="SemiBold" 
                                       Foreground="#1f2937" LineHeight="19"/>
                            <!-- Icon Message Bubble -->
                            <Path Grid.Row="1" Width="18" Height="18" Stretch="Uniform" Fill="#64748b" HorizontalAlignment="Left" Margin="0,16,0,0"
                                  Data="M20 2H4c-1.1 0-1.99.9-1.99 2L2 22l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zM6 9h12v2H6V9zm8 5H6v-2h8v2zm4-6H6V6h12v2z"/>
                        </Grid>
                    </Button>

                    <!-- Card 4 -->
                    <Button Grid.Column="3" Style="{StaticResource PromptCardButtonStyle}" Click="PromptCard_Click" Tag="4">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="TxtPrompt4" Grid.Row="0"
                                       Text="How does AI work in a technical capacity"
                                       TextWrapping="Wrap" FontSize="13" FontWeight="SemiBold" 
                                       Foreground="#1f2937" LineHeight="19"/>
                            <!-- Icon Sliders / Settings -->
                            <Path Grid.Row="1" Width="18" Height="18" Stretch="Uniform" Fill="#64748b" HorizontalAlignment="Left" Margin="0,16,0,0"
                                  Data="M3 17v2h6v-2H3zM3 5v2h10V5H3zm10 16v-2h8v-2h-8v-2h-2v6h2zM7 9v2H3v2h4v2h2V9H7zm14 4v-2H11v2h10zm-6-4h2V7h4V5h-4V3h-2v6z"/>
                        </Grid>
                    </Button>
                </Grid>

                <!-- 1.4 NÚT REFRESH PROMPTS -->
                <Button Grid.Row="3" Style="{StaticResource SubtleActionButtonStyle}" 
                        HorizontalAlignment="Left" Margin="0,0,0,28" Click="BtnRefreshPrompts_Click">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Icon Refresh / Reload -->
                        <Path Width="14" Height="14" Stretch="Uniform" Fill="#64748b" Margin="0,0,8,0"
                              Data="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"/>
                        <TextBlock Text="Refresh Prompts" FontSize="13" Foreground="#64748b" FontWeight="Medium"/>
                    </StackPanel>
                </Button>

                <!-- 1.5 KHUNG NHẬP CHAT CHÍNH (MAIN PROMPT CARD) -->
                <Border Grid.Row="4" Background="#ffffff" CornerRadius="22" BorderBrush="#e2e8f0" BorderThickness="1"
                        Padding="22,18,20,16">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="30" ShadowDepth="4" Opacity="0.06" Color="#0f172a" Direction="270"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Vùng gõ nội dung + Dropdown All Web -->
                            <RowDefinition Height="Auto"/> <!-- Vùng chân Attachment + Image + Count + Send -->
                        </Grid.RowDefinitions>

                        <!-- Hàng trên: Input + Pill Dropdown "All Web ˅" -->
                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Khung nhập văn bản với Placeholder -->
                            <Grid Grid.Column="0">
                                <TextBlock x:Name="TxtPlaceholder" Text="Ask whatever you want...." 
                                           FontSize="15" Foreground="#94a3b8" Margin="4,4,0,0"
                                           IsHitTestVisible="False"/>
                                <TextBox x:Name="TxtMainInput" FontSize="15" Foreground="#0f172a"
                                         Background="Transparent" BorderThickness="0"
                                         AcceptsReturn="True" TextWrapping="Wrap"
                                         MinHeight="60" MaxHeight="140"
                                         VerticalScrollBarVisibility="Auto"
                                         TextChanged="TxtMainInput_TextChanged"
                                         KeyDown="TxtMainInput_KeyDown"/>
                            </Grid>

                            <!-- Dropdown Pill "All Web ˅" -->
                            <Border Grid.Column="1" VerticalAlignment="Top"
                                    Background="#f8fafc" BorderBrush="#e2e8f0" BorderThickness="1"
                                    CornerRadius="14" Padding="10,5" Margin="12,0,0,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Icon Globe -->
                                    <Path Width="14" Height="14" Stretch="Uniform" Fill="#475569" Margin="0,0,6,0"
                                          Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"/>
                                    <TextBlock Text="All Web" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,6,0"/>
                                    <!-- Chevron Down -->
                                    <Path Width="10" Height="10" Stretch="Uniform" Fill="#94a3b8"
                                          Data="M7.41 8.59L12 13.17l4.59-4.58L18 10l-6 6-6-6 1.41-1.41z"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Hàng dưới: + Add Attachment | Use Image | 0/1000 | Nút Send tím -->
                        <DockPanel Grid.Row="1" LastChildFill="False">
                            <!-- Bên trái: Các công cụ đính kèm -->
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- + Add Attachment -->
                                <Button Style="{StaticResource SubtleActionButtonStyle}" Margin="0,0,12,0" Click="BtnAttachment_Click">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Width="15" Height="15" Stretch="Uniform" Fill="#64748b" Margin="0,0,6,0"
                                              Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/>
                                        <TextBlock Text="Add Attachment" FontSize="13" Foreground="#64748b" FontWeight="Medium"/>
                                    </StackPanel>
                                </Button>

                                <!-- Use Image -->
                                <Button Style="{StaticResource SubtleActionButtonStyle}" Click="BtnUseImage_Click">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Width="15" Height="15" Stretch="Uniform" Fill="#64748b" Margin="0,0,6,0"
                                              Data="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z"/>
                                        <TextBlock Text="Use Image" FontSize="13" Foreground="#64748b" FontWeight="Medium"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- Bên phải: Bộ đếm ký tự + Nút gửi tím -->
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtCharCounter" Text="0/1000" 
                                           FontSize="12" Foreground="#94a3b8" 
                                           VerticalAlignment="Center" Margin="0,0,14,0"/>

                                <!-- Nút Gửi Send tròn tím -->
                                <Button x:Name="BtnSend" Width="36" Height="36" Cursor="Hand" Click="BtnSend_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="btnBorder" CornerRadius="18">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#7c3aed" Offset="0.0"/>
                                                        <GradientStop Color="#6366f1" Offset="1.0"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <!-- Icon Mũi Tên Sang Phải -->
                                                <Path Width="14" Height="14" Stretch="Uniform" Fill="#ffffff" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Data="M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="btnBorder" Property="Opacity" Value="0.9"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="btnBorder" Property="Opacity" Value="0.75"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </DockPanel>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- ================= 2. KHÔNG GIAN HỘI THOẠI ĐANG CHAT (ACTIVE CHAT SESSION) ================= -->
        <Grid x:Name="ActiveChatContainer" Visibility="Collapsed" Margin="20,10,20,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Thanh tiêu đề hội thoại + Nút Quay lại (New Chat) -->
                <RowDefinition Height="*"/>    <!-- Danh sách tin nhắn cuộn -->
                <RowDefinition Height="Auto"/> <!-- Khung nhập tin nhắn dính chân trang -->
            </Grid.RowDefinitions>

            <!-- 2.1 Thanh điều hướng Header Chat -->
            <Border Grid.Row="0" Background="#ffffff" CornerRadius="14" BorderBrush="#e2e8f0" BorderThickness="1" Padding="18,12" Margin="0,0,0,12">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="34" Height="34" CornerRadius="17" Margin="0,0,10,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#7c3aed" Offset="0.0"/>
                                    <GradientStop Color="#6366f1" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Path Width="16" Height="16" Stretch="Uniform" Fill="#ffffff" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Data="M12 2C6.48 2 2 6.48 2 12c0 1.85.5 3.58 1.38 5.08L2 22l5.08-1.38C8.58 21.5 10.15 22 12 22c5.52 0 10-4.48 10-10S17.52 2 12 2zm-1 14h-2v-2h2v2zm0-4h-2V7h2v5z"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="DeskPilot AI Assistant" FontSize="14" FontWeight="Bold" Foreground="#0f172a"/>
                            <TextBlock Text="Đang trực tuyến • Sẵn sàng hỗ trợ quản trị hệ thống" FontSize="11" Foreground="#10b981"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Nút Làm Mới / Quay Lại Landing Page -->
                    <Button DockPanel.Dock="Right" Style="{StaticResource SubtleActionButtonStyle}" Click="BtnNewChat_Click" Padding="12,6">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Width="13" Height="13" Stretch="Uniform" Fill="#64748b" Margin="0,0,6,0"
                                  Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/>
                            <TextBlock Text="Cuộc trò chuyện mới" FontSize="12" FontWeight="SemiBold" Foreground="#475569"/>
                        </StackPanel>
                    </Button>
                </DockPanel>
            </Border>

            <!-- 2.2 Danh sách tin nhắn cuộc trò chuyện -->
            <ScrollViewer Grid.Row="1" x:Name="ChatMessagesScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,12">
                <StackPanel x:Name="ChatMessagesStack" Margin="8,4,8,8"/>
            </ScrollViewer>

            <!-- 2.3 Khung nhập Prompt tại chân trang cuộc trò chuyện -->
            <Border Grid.Row="2" Background="#ffffff" CornerRadius="18" BorderBrush="#e2e8f0" BorderThickness="1" Padding="16,12">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.05" Color="#0f172a" Direction="270"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="TxtActiveChatInput" Grid.Column="0" FontSize="14" Foreground="#0f172a"
                             Background="Transparent" BorderThickness="0"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             MaxHeight="80" VerticalScrollBarVisibility="Auto"
                             KeyDown="TxtActiveChatInput_KeyDown"/>

                    <Button Grid.Column="1" Width="34" Height="34" Margin="10,0,0,0" Cursor="Hand" Click="BtnActiveSend_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border CornerRadius="17">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#7c3aed" Offset="0.0"/>
                                            <GradientStop Color="#6366f1" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Path Width="14" Height="14" Stretch="Uniform" Fill="#ffffff" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Data="M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
