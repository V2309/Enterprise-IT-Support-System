<UserControl x:Class="DeskPilot.Admin.Views.MaintenanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Background="Transparent">

    <UserControl.Resources>
        <Style x:Key="PrimaryActionBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#2563eb"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1d4ed8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1e40af"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OutlineActionBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#eff6ff"/>
            <Setter Property="Foreground" Value="#2563eb"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="#bfdbfe"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#dbeafe"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 1. Header -->
            <RowDefinition Height="Auto"/>
            <!-- 2. KPI Summary Cards -->
            <RowDefinition Height="Auto"/>
            <!-- 3. Filter Bar -->
            <RowDefinition Height="*"/>
            <!-- 4. DataGrid -->
        </Grid.RowDefinitions>

        <!-- ================= 1. HEADER & ACTIONS ================= -->
        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Left">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Kế Hoạch Bảo Trì Định Kỳ" FontSize="20" FontWeight="Bold" Foreground="#0f172a" Margin="0,0,10,0"/>
                    <Border Background="#dbeafe" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                        <TextBlock Text="IT Command Center" Foreground="#1e40af" FontSize="11" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="Quản lý chu kỳ bảo dưỡng, vệ sinh phần cứng, cập nhật hệ điều hành và kiểm tra an ninh máy trạm" FontSize="12" Foreground="#64748b" Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="Làm mới" Style="{StaticResource OutlineActionBtnStyle}" Margin="0,0,8,0" Click="BtnRefresh_Click"/>
                <Button Content="+ Lập Kế Hoạch Mới" Style="{StaticResource PrimaryActionBtnStyle}" Click="BtnAddMaintenance_Click"/>
            </StackPanel>
        </DockPanel>

        <!-- ================= 2. KPI SUMMARY CARDS ================= -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Card 1: Tổng kế hoạch -->
            <Border Grid.Column="0" Background="#ffffff" CornerRadius="12" BorderBrush="#e2e8f0" BorderThickness="1" Padding="14,12" Margin="0,0,8,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="TỔNG KẾ HOẠCH" FontSize="11" FontWeight="SemiBold" Foreground="#64748b"/>
                        <TextBlock Text="{Binding MaintenanceSchedules.Count}" FontSize="22" FontWeight="Bold" Foreground="#0f172a" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Width="38" Height="38" CornerRadius="10" Background="#eff6ff" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="CalendarLtr24" Foreground="#2563eb" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Card 2: Đang chờ thực hiện -->
            <Border Grid.Column="1" Background="#ffffff" CornerRadius="12" BorderBrush="#e2e8f0" BorderThickness="1" Padding="14,12" Margin="4,0,8,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="CHỜ THỰC HIỆN" FontSize="11" FontWeight="SemiBold" Foreground="#64748b"/>
                        <TextBlock Text="Đang theo dõi" FontSize="13" FontWeight="SemiBold" Foreground="#2563eb" Margin="0,8,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Width="38" Height="38" CornerRadius="10" Background="#f5f3ff" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Clock24" Foreground="#7c3aed" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Card 3: Cảnh báo quá hạn -->
            <Border Grid.Column="2" Background="#ffffff" CornerRadius="12" BorderBrush="#fecaca" BorderThickness="1" Padding="14,12" Margin="4,0,8,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="CẢNH BÁO TRỄ HẠN" FontSize="11" FontWeight="Bold" Foreground="#dc2626"/>
                        <TextBlock Text="Cần xử lý ngay" FontSize="13" FontWeight="SemiBold" Foreground="#dc2626" Margin="0,8,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Width="38" Height="38" CornerRadius="10" Background="#fef2f2" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Warning24" Foreground="#dc2626" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Card 4: Đã hoàn thành -->
            <Border Grid.Column="3" Background="#ffffff" CornerRadius="12" BorderBrush="#e2e8f0" BorderThickness="1" Padding="14,12" Margin="4,0,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="ĐÃ HOÀN TẤT" FontSize="11" FontWeight="SemiBold" Foreground="#64748b"/>
                        <TextBlock Text="Đã nghiệm thu" FontSize="13" FontWeight="SemiBold" Foreground="#059669" Margin="0,8,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Width="38" Height="38" CornerRadius="10" Background="#ecfdf5" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="CheckmarkCircle24" Foreground="#059669" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ================= 3. BỘ LỌC TÌM KIẾM ================= -->
        <Border Grid.Row="2" Background="#ffffff" CornerRadius="12" BorderBrush="#e2e8f0" BorderThickness="1" Padding="14,10" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.2*"/>
                    <ColumnDefinition Width="1.3*"/>
                    <ColumnDefinition Width="1.3*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Search -->
                <Border Grid.Column="0" Background="#f8fafc" BorderBrush="#e2e8f0" BorderThickness="1" CornerRadius="8" Padding="10,0" Height="36" Margin="0,0,10,0">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="Search24" Foreground="#94a3b8" FontSize="14" Margin="0,0,8,0"/>
                        <TextBox x:Name="TxtSearch" Grid.Column="1" BorderThickness="0" Background="Transparent" Foreground="#0f172a" FontSize="12" VerticalContentAlignment="Center" ToolTip="Tìm theo tiêu đề, kỹ thuật viên, thiết bị, ghi chú..."/>
                    </Grid>
                </Border>

                <!-- Lọc phòng ban -->
                <ComboBox x:Name="CmbDepartment" Grid.Column="1" Height="36" Margin="0,0,10,0" VerticalContentAlignment="Center" FontSize="12">
                    <ComboBoxItem Content="Tất cả phòng ban" IsSelected="True"/>
                    <ComboBoxItem Content="Kế toán"/>
                    <ComboBoxItem Content="Kinh doanh"/>
                    <ComboBoxItem Content="Kỹ thuật"/>
                    <ComboBoxItem Content="Nhân sự"/>
                    <ComboBoxItem Content="Marketing"/>
                    <ComboBoxItem Content="Ban giám đốc"/>
                </ComboBox>

                <!-- Lọc trạng thái -->
                <ComboBox x:Name="CmbStatus" Grid.Column="2" Height="36" Margin="0,0,10,0" VerticalContentAlignment="Center" FontSize="12">
                    <ComboBoxItem Content="Tất cả trạng thái" IsSelected="True"/>
                    <ComboBoxItem Content="Lên kế hoạch" Tag="Planned"/>
                    <ComboBoxItem Content="Đang tiến hành" Tag="InProgress"/>
                    <ComboBoxItem Content="Đã hoàn tất" Tag="Completed"/>
                    <ComboBoxItem Content="Quá hạn" Tag="Overdue"/>
                    <ComboBoxItem Content="Đã hủy" Tag="Cancelled"/>
                </ComboBox>

                <!-- Chỉ hiện quá hạn -->
                <CheckBox x:Name="ChkOverdueOnly" Grid.Column="3" Content="Chỉ hiện quá hạn" VerticalAlignment="Center" Margin="6,0,14,0" FontSize="12" Foreground="#dc2626" FontWeight="SemiBold"/>

                <!-- Nút Lọc -->
                <Button Grid.Column="4" Content="Lọc dữ liệu" Style="{StaticResource PrimaryActionBtnStyle}" Height="36" Click="BtnFilter_Click"/>
            </Grid>
        </Border>

        <!-- ================= 4. DANH SÁCH BẢO TRÌ DATAGRID (PREMIUM DESIGN) ================= -->
        <Border Grid.Row="3" Background="#ffffff" CornerRadius="14" BorderBrush="#e2e8f0" BorderThickness="1" Padding="14">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.04" Color="#0f172a" Direction="270"/>
            </Border.Effect>

            <DataGrid ItemsSource="{Binding MaintenanceSchedules}" AutoGenerateColumns="False" 
                      CanUserAddRows="False" IsReadOnly="True" Background="Transparent" 
                      BorderThickness="0" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                      HorizontalGridLinesBrush="#f1f5f9" RowBackground="#ffffff"
                      AlternatingRowBackground="#fafbfc" RowHeight="58">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#f8fafc"/>
                        <Setter Property="Foreground" Value="#475569"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="Padding" Value="14,10"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#e2e8f0"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#f8fafc"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>

                <DataGrid.Columns>
                    <!-- Cột 1: Kế Hoạch & Chi Tiết -->
                    <DataGridTemplateColumn Header="Kế Hoạch Bảo Trì" Width="2.8*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center" Margin="10,0">
                                    <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="13" Foreground="#0f172a" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding ChecklistNotes}" FontSize="11" Foreground="#64748b" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Cột 2: Đối Tượng Áp Dụng -->
                    <DataGridTemplateColumn Header="Đối Tượng" Width="1.3*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="#f1f5f9" BorderBrush="#e2e8f0" BorderThickness="1" CornerRadius="8" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Desktop20" FontSize="13" Foreground="#475569" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding TargetDisplay}" FontSize="11" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Cột 3: Loại Hình & Chu Kỳ -->
                    <DataGridTemplateColumn Header="Loại Hình &amp; Chu Kỳ" Width="1.5*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center" Margin="10,0">
                                    <TextBlock Text="{Binding MaintenanceTypeDisplay}" FontSize="12" FontWeight="SemiBold" Foreground="#0f172a"/>
                                    <TextBlock Text="{Binding FrequencyDisplay, StringFormat='{}Chu kỳ: {0}'}" FontSize="11" Foreground="#64748b" Margin="0,2,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Cột 4: Hạn Kế Tiếp -->
                    <DataGridTemplateColumn Header="Hạn Kế Tiếp" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center" Margin="10,0">
                                    <TextBlock Text="{Binding NextDueDateFormatted}" FontSize="12" FontWeight="Bold" Foreground="#0f172a"/>
                                    <TextBlock Text="{Binding DueDateFormatted, StringFormat='{}Gốc: {0}'}" FontSize="10" Foreground="#94a3b8" Margin="0,2,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Cột 5: Kỹ Thuật Viên -->
                    <DataGridTemplateColumn Header="Phụ Trách" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                                    <Border Width="24" Height="24" CornerRadius="12" Background="#e2e8f0" Margin="0,0,6,0">
                                        <ui:SymbolIcon Symbol="Person20" FontSize="13" Foreground="#475569" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="{Binding AssignedTechnician}" FontSize="12" Foreground="#334155" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Cột 6: Trạng Thái (Pill Badge Đẹp) -->
                    <DataGridTemplateColumn Header="Trạng Thái" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding StatusBgColor}" BorderBrush="{Binding StatusBorderColor}" BorderThickness="1" CornerRadius="12" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="6" Height="6" Fill="{Binding StatusDotColor}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding StatusDisplay}" FontSize="11" FontWeight="Bold" Foreground="{Binding StatusFgColor}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Cột 7: Thao Tác (Icon Only) -->
                    <DataGridTemplateColumn Header="Thao Tác" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Nút Icon Done / Nghiệm thu -->
                                    <Button Width="30" Height="30" Padding="0" Background="#ecfdf5" Foreground="#059669"
                                            BorderBrush="#a7f3d0" BorderThickness="1"
                                            Margin="0,0,6,0" Cursor="Hand" Click="BtnCompleteRow_Click" ToolTip="Nghiệm thu &amp; Tính kỳ tiếp theo">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="7"/>
                                            </Style>
                                        </Button.Resources>
                                        <ui:SymbolIcon Symbol="Checkmark20" FontSize="14" Foreground="#059669" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Button>

                                    <!-- Nút Icon Edit / Sửa -->
                                    <Button Width="30" Height="30" Padding="0" Background="#f1f5f9" Foreground="#334155"
                                            BorderThickness="0" Margin="0,0,6,0" Cursor="Hand" Click="BtnEditRow_Click" ToolTip="Chỉnh sửa">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="7"/>
                                            </Style>
                                        </Button.Resources>
                                        <ui:SymbolIcon Symbol="Edit20" FontSize="14" Foreground="#475569" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Button>

                                    <!-- Nút Icon X / Xóa -->
                                    <Button Width="30" Height="30" Padding="0" Background="#fef2f2" Foreground="#ef4444"
                                            BorderThickness="0" Cursor="Hand" Click="BtnDeleteRow_Click" ToolTip="Xóa kế hoạch">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="7"/>
                                            </Style>
                                        </Button.Resources>
                                        <ui:SymbolIcon Symbol="Dismiss20" FontSize="13" Foreground="#ef4444" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ================= 5. MODAL DIALOG IN-APP LẬP/SỬA KẾ HOẠCH BẢO TRÌ ================= -->
        <Grid x:Name="MaintenanceModalBackdrop" Grid.Row="0" Grid.RowSpan="4" Visibility="Collapsed" Background="#800f172a" Panel.ZIndex="100">
            <Border Width="600" Background="#ffffff" CornerRadius="16" BorderBrush="#e2e8f0" BorderThickness="1" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="4" Opacity="0.2" Color="#0f172a"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock x:Name="TxtModalTitle" Text="Lập Kế Hoạch Bảo Trì Mới" FontSize="16" FontWeight="Bold" Foreground="#0f172a" Margin="0,0,0,18"/>

                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="Tiêu đề kế hoạch *" FontSize="12" Foreground="#475569" Margin="0,0,0,4"/>
                        <TextBox x:Name="ModalTitle" Height="34" VerticalContentAlignment="Center" FontSize="12" Padding="8,0" ToolTip="Ví dụ: Vệ sinh tra keo tản nhiệt định kỳ Q2 dàn máy Kế toán"/>
                    </StackPanel>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Phòng ban áp dụng" FontSize="12" Foreground="#475569" Margin="0,0,0,4"/>
                            <ComboBox x:Name="ModalDepartment" Height="34" VerticalContentAlignment="Center" FontSize="12">
                                <ComboBoxItem Content="Kế toán" IsSelected="True"/>
                                <ComboBoxItem Content="Kinh doanh"/>
                                <ComboBoxItem Content="Kỹ thuật"/>
                                <ComboBoxItem Content="Nhân sự"/>
                                <ComboBoxItem Content="Marketing"/>
                                <ComboBoxItem Content="Ban giám đốc"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="Thiết bị cụ thể (nếu có)" FontSize="12" Foreground="#475569" Margin="0,0,0,4"/>
                            <ComboBox x:Name="ModalDevice" Height="34" VerticalContentAlignment="Center" FontSize="12" DisplayMemberPath="Name" SelectedValuePath="Id"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Loại hình bảo trì" FontSize="12" Foreground="#475569" Margin="0,0,0,4"/>
                            <ComboBox x:Name="ModalType" Height="34" VerticalContentAlignment="Center" FontSize="12">
                                <ComboBoxItem Content="Vệ sinh phần cứng" Tag="HardwareCleaning" IsSelected="True"/>
                                <ComboBoxItem Content="Cập nhật HĐH &amp; Phần mềm" Tag="SoftwareUpdate"/>
                                <ComboBoxItem Content="Kiểm tra an ninh &amp; Antivirus" Tag="SecurityCheck"/>
                                <ComboBoxItem Content="Sao lưu dữ liệu định kỳ" Tag="BackupData"/>
                                <ComboBoxItem Content="Bảo dưỡng máy in &amp; Mực" Tag="PrinterService"/>
                                <ComboBoxItem Content="Kiểm tra thiết bị mạng" Tag="NetworkInspection"/>
                                <ComboBoxItem Content="Kiểm tra tổng thể" Tag="FullInspection"/>
                                <ComboBoxItem Content="Bảo trì khác" Tag="Other"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="Chu kỳ định kỳ" FontSize="12" Foreground="#475569" Margin="0,0,0,4"/>
                            <ComboBox x:Name="ModalFrequency" Height="34" VerticalContentAlignment="Center" FontSize="12">
                                <ComboBoxItem Content="Một lần duy nhất" Tag="OneTime"/>
                                <ComboBoxItem Content="Hàng tuần" Tag="Weekly"/>
                                <ComboBoxItem Content="Hàng tháng" Tag="Monthly"/>
                                <ComboBoxItem Content="Hàng quý (3 tháng)" Tag="Quarterly" IsSelected="True"/>
                                <ComboBoxItem Content="Nửa năm (6 tháng)" Tag="SemiAnnually"/>
                                <ComboBoxItem Content="Hàng năm" Tag="Annually"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock Text="Ngày dự kiến thực hiện" FontSize="12" Foreground="#475569" Margin="0,0,0,4"/>
                            <DatePicker x:Name="ModalScheduledDate" Height="34" FontSize="12"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="6,0,6,0">
                            <TextBlock Text="Kỹ thuật viên phụ trách" FontSize="12" Foreground="#475569" Margin="0,0,0,4"/>
                            <TextBox x:Name="ModalTechnician" Height="34" VerticalContentAlignment="Center" FontSize="12" Padding="8,0" Text="IT Support"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Margin="6,0,0,0">
                            <TextBlock Text="Trạng thái" FontSize="12" Foreground="#475569" Margin="0,0,0,4"/>
                            <ComboBox x:Name="ModalStatus" Height="34" VerticalContentAlignment="Center" FontSize="12">
                                <ComboBoxItem Content="Lên kế hoạch" Tag="Planned" IsSelected="True"/>
                                <ComboBoxItem Content="Đang tiến hành" Tag="InProgress"/>
                                <ComboBoxItem Content="Đã hoàn tất" Tag="Completed"/>
                                <ComboBoxItem Content="Đã hủy" Tag="Cancelled"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <StackPanel Margin="0,0,0,18">
                        <TextBlock Text="Hạng mục checklist &amp; Ghi chú công việc" FontSize="12" Foreground="#475569" Margin="0,0,0,4"/>
                        <TextBox x:Name="ModalChecklist" Height="60" TextWrapping="Wrap" AcceptsReturn="True" FontSize="12" Padding="8,6"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Hủy bỏ" Style="{StaticResource OutlineActionBtnStyle}" Margin="0,0,10,0" Click="ModalBtnCancel_Click"/>
                        <Button Content="Lưu kế hoạch" Style="{StaticResource PrimaryActionBtnStyle}" Click="ModalBtnSave_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ================= 6. MODAL DIALOG IN-APP NGHIỆM THU / HOÀN TẤT BẢO TRÌ ================= -->
        <Grid x:Name="CompleteModalBackdrop" Grid.Row="0" Grid.RowSpan="4" Visibility="Collapsed" Background="#800f172a" Panel.ZIndex="100">
            <Border Width="500" Background="#ffffff" CornerRadius="16" BorderBrush="#e2e8f0" BorderThickness="1" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="4" Opacity="0.2" Color="#0f172a"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Nghiệm Thu &amp; Hoàn Tất Bảo Trì" FontSize="16" FontWeight="Bold" Foreground="#0f172a" Margin="0,0,0,8"/>
                    <TextBlock x:Name="TxtCompleteSubtitle" Text="Ghi nhận kết quả sau khi bảo dưỡng xong thiết bị" FontSize="12" Foreground="#64748b" Margin="0,0,0,16"/>

                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="Người thực hiện" FontSize="12" Foreground="#475569" Margin="0,0,0,4"/>
                        <TextBox x:Name="CompletePerformedBy" Height="34" VerticalContentAlignment="Center" FontSize="12" Padding="8,0" Text="IT Support"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,18">
                        <TextBlock Text="Kết quả kiểm tra / Linh kiện thay thế / Đánh giá *" FontSize="12" Foreground="#475569" Margin="0,0,0,4"/>
                        <TextBox x:Name="CompleteResultSummary" Height="80" TextWrapping="Wrap" AcceptsReturn="True" FontSize="12" Padding="8,6" ToolTip="Ghi chú: Đã thổi bụi, tra keo MX-4, nhiệt độ CPU giảm từ 82C xuống 55C, máy chạy êm..."/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Hủy bỏ" Style="{StaticResource OutlineActionBtnStyle}" Margin="0,0,10,0" Click="CompleteBtnCancel_Click"/>
                        <Button Content="Xác nhận hoàn tất" Style="{StaticResource PrimaryActionBtnStyle}" Click="CompleteBtnSave_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
