<UserControl x:Class="DeskPilot.Admin.Views.TicketsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Background="Transparent">

    <UserControl.Resources>
        <Style x:Key="ResolveTicketButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#10b981"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="14,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#059669"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#047857"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Quản Lý Phiếu Hỗ Trợ (Tickets)" FontSize="18" FontWeight="Bold" Foreground="#0f172a"/>
                <TextBlock Text="Theo dõi tiến độ xử lý và phản hồi sự cố từ người dùng thời gian thực" FontSize="12" Foreground="#64748b" Margin="0,2,0,0"/>
            </StackPanel>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Border Background="#fef3c7" BorderBrush="#fde68a" BorderThickness="1" CornerRadius="8" Padding="12,6">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Warning20" Foreground="#d97706" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Tickets.Count, StringFormat='{}Chờ xử lý: {0} phiếu'}" Foreground="#b45309" FontWeight="Bold" FontSize="12"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </DockPanel>

        <!-- Bảng danh sách phiếu -->
        <Border Grid.Row="1" Background="#ffffff" CornerRadius="14" BorderBrush="#e2e8f0" BorderThickness="1" Padding="16">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.04" Color="#0f172a" Direction="270"/>
            </Border.Effect>

            <DataGrid ItemsSource="{Binding Tickets}" AutoGenerateColumns="False" 
                      CanUserAddRows="False" IsReadOnly="True" Background="Transparent" 
                      BorderThickness="0" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                      HorizontalGridLinesBrush="#f1f5f9" RowBackground="#ffffff"
                      AlternatingRowBackground="#fafafa" RowHeight="40">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#f8fafc"/>
                        <Setter Property="Foreground" Value="#475569"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="Padding" Value="12,8"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#e2e8f0"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#eff6ff"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Thời Gian Gửi" Binding="{Binding CreatedAt, StringFormat='{}{0:HH:mm:ss dd/MM/yyyy}'}" Width="150"/>
                    <DataGridTextColumn Header="Máy Trạm" Binding="{Binding MachineName}" Width="130"/>
                    <DataGridTextColumn Header="Người Dùng" Binding="{Binding UserName}" Width="130"/>
                    <DataGridTextColumn Header="Mô Tả Sự Cố" Binding="{Binding Description}" Width="*"/>
                    <DataGridTextColumn Header="Trạng Thái" Binding="{Binding Status}" Width="110"/>

                    <DataGridTemplateColumn Header="Hành Động" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="✓ Hoàn tất" Style="{StaticResource ResolveTicketButtonStyle}" Click="BtnResolveTicket_Click"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
