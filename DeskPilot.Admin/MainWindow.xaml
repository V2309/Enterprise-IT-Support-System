<Window x:Class="DeskPilot.Admin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="DeskPilot - IT Command Center" 
        Height="840" Width="1360"
        MinHeight="720" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/app.ico"
        Background="#f8fafc">

    <Window.Resources>
        <!-- Nút Menu Chính Sidebar (Dark Navy Theme) -->
        <Style x:Key="SidebarMenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#94a3b8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1e293b"/>
                                <Setter Property="Foreground" Value="#f8fafc"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nút Menu Chính Khi Được Chọn (Active Solid Blue Pill) -->
        <Style x:Key="SidebarMenuButtonActiveStyle" TargetType="Button" BasedOn="{StaticResource SidebarMenuButtonStyle}">
            <Setter Property="Background" Value="#2563eb"/>
            <Setter Property="Foreground" Value="#ffffff"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Nút Danh Sách Phòng Ban -->
        <Style x:Key="DeptButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#94a3b8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1e293b"/>
                                <Setter Property="Foreground" Value="#f8fafc"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nút Xác Nhận Modal In-App (Solid Soft Blue / Modern Emerald) -->
        <Style x:Key="ModalConfirmButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2563eb"/>
            <Setter Property="Foreground" Value="#ffffff"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nút Hủy Modal In-App (Outlined Slate) -->
        <Style x:Key="ModalCancelButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#f8fafc"/>
            <Setter Property="BorderBrush" Value="#cbd5e1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#f1f5f9"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#94a3b8"/>
                                <Setter Property="Foreground" Value="#0f172a"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#e2e8f0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="235"/>
            <!-- 1. Sidebar Trái Cố Định -->
            <ColumnDefinition Width="*"/>
            <!-- 2. Vùng Làm Việc (Header + Content Website) -->
        </Grid.ColumnDefinitions>

        <!-- ================= 1. SIDEBAR TRÁI CỐ ĐỊNH (DARK NAVY) ================= -->
        <Border Grid.Column="0" Background="#0f172a" BorderBrush="#1e293b" BorderThickness="0,0,1,0">
            <Grid Margin="16,20,16,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Logo / Brand -->
                    <RowDefinition Height="Auto"/>
                    <!-- Menu Điều Hướng Chính -->
                    <RowDefinition Height="Auto"/>
                    <!-- Phân cách Phòng Ban -->
                    <RowDefinition Height="*"/>
                    <!-- Danh Sách Phòng Ban Cuộn -->
                    <RowDefinition Height="Auto"/>
                    <!-- Cài Đặt Dưới Cùng -->
                </Grid.RowDefinitions>

                <!-- 1.1 Brand Header: Logo + Tên App -->
                <StackPanel Grid.Row="0" Margin="0,0,0,24">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="34" Height="34" CornerRadius="8" Background="#2563eb" Margin="0,0,10,0">
                            <ui:SymbolIcon Symbol="Send24" Foreground="White" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="-1,1,0,0"/>
                        </Border>
                        <TextBlock Text="DeskPilot" FontSize="18" FontWeight="Bold" Foreground="#ffffff" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <!-- 1.2 Menu Điều Hướng Chính -->
                <StackPanel Grid.Row="1" Margin="0,0,0,20">
                    <!-- Tab 1: Tổng quan -->
                    <Button Click="NavOverview_Click" Margin="0,0,0,4">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarMenuButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDashboardActive}" Value="True">
                                        <Setter Property="Background" Value="#2563eb"/>
                                        <Setter Property="Foreground" Value="#ffffff"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Home24" FontSize="16" Margin="0,0,10,0"/>
                            <TextBlock Text="Tổng quan" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Tab 2: Danh sách Ticket -->
                    <Button Click="NavTickets_Click" Margin="0,0,0,4">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarMenuButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTicketsActive}" Value="True">
                                        <Setter Property="Background" Value="#2563eb"/>
                                        <Setter Property="Foreground" Value="#ffffff"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <DockPanel LastChildFill="True">
                            <ui:SymbolIcon Symbol="DocumentBulletList24" FontSize="16" Margin="0,0,10,0" DockPanel.Dock="Left"/>
                            <TextBlock Text="Danh sách Ticket" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                            <Border Background="#ef4444" CornerRadius="10" Padding="6,1" HorizontalAlignment="Right" DockPanel.Dock="Right" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Tickets.Count}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                            </Border>
                        </DockPanel>
                    </Button>

                    <!-- Tab 3: Quản lý Runbook/Script -->
                    <Button Click="NavLogs_Click">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarMenuButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLogsActive}" Value="True">
                                        <Setter Property="Background" Value="#2563eb"/>
                                        <Setter Property="Foreground" Value="#ffffff"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Play24" FontSize="16" Margin="0,0,10,0"/>
                            <TextBlock Text="Quản lý Runbook/Script" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- 1.3 Tiêu Đề Mục Phòng Ban -->
                <TextBlock Grid.Row="2" Text="PHÒNG BAN" FontSize="10" FontWeight="Bold" Foreground="#64748b" Margin="10,0,0,8"/>

                <!-- 1.4 Danh Sách Lọc Theo Phòng Ban -->
                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Button Style="{StaticResource DeptButtonStyle}" Tag="Kế toán (12)" Click="DeptButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="People20" FontSize="14" Margin="0,0,8,0"/>
                                <TextBlock Text="Kế toán (12)"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource DeptButtonStyle}" Tag="Kinh doanh (10)" Click="DeptButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="People20" FontSize="14" Margin="0,0,8,0"/>
                                <TextBlock Text="Kinh doanh (10)"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource DeptButtonStyle}" Tag="Kỹ thuật (8)" Click="DeptButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="People20" FontSize="14" Margin="0,0,8,0"/>
                                <TextBlock Text="Kỹ thuật (8)"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource DeptButtonStyle}" Tag="Nhân sự (6)" Click="DeptButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="People20" FontSize="14" Margin="0,0,8,0"/>
                                <TextBlock Text="Nhân sự (6)"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource DeptButtonStyle}" Tag="Marketing (5)" Click="DeptButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="People20" FontSize="14" Margin="0,0,8,0"/>
                                <TextBlock Text="Marketing (5)"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource DeptButtonStyle}" Tag="Ban giám đốc (3)" Click="DeptButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="People20" FontSize="14" Margin="0,0,8,0"/>
                                <TextBlock Text="Ban giám đốc (3)"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <!-- 1.5 Cài Đặt Dưới Cùng -->
                <Button Grid.Row="4" Style="{StaticResource SidebarMenuButtonStyle}" Click="NavSettings_Click" Margin="0,10,0,0">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Settings24" FontSize="16" Margin="0,0,10,0"/>
                        <TextBlock Text="Cài đặt" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ================= 2. KHU VỰC CHÍNH BÊN PHẢI ================= -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <!-- Header Dùng Chung -->
                <RowDefinition Height="*"/>
                <!-- Vùng Content Render Động (SPA Website-like) -->
            </Grid.RowDefinitions>

            <!-- 2.1 HEADER DÙNG CHUNG (WHITE, CLEAN) -->
            <Border Grid.Row="0" Background="#ffffff" BorderBrush="#e2e8f0" BorderThickness="0,0,0,1" Padding="24,0">
                <DockPanel LastChildFill="True">
                    <!-- Bên trái: Thanh tìm kiếm toàn cục -->
                    <Border DockPanel.Dock="Left" Background="#f8fafc" BorderBrush="#e2e8f0" BorderThickness="1" 
                            CornerRadius="20" Height="38" Width="360" VerticalAlignment="Center" Padding="12,0">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="Search24" Foreground="#94a3b8" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                                     Background="Transparent" BorderThickness="0" Foreground="#0f172a" FontSize="12"
                                     VerticalContentAlignment="Center" ToolTip="Tìm kiếm máy trạm, nhân viên, ticket..."/>
                        </Grid>
                    </Border>

                    <!-- Bên phải: Thông báo & Profile Admin -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <!-- Chuông thông báo có badge đỏ -->
                        <Border Width="38" Height="38" CornerRadius="19" Background="#f8fafc" BorderBrush="#e2e8f0" BorderThickness="1" 
                                Margin="0,0,16,0" Cursor="Hand" ToolTip="Thông báo mới">
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Alert24" Foreground="#64748b" FontSize="17"/>
                                <Border Background="#ef4444" CornerRadius="6" Width="14" Height="14" 
                                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8,-5,-6,0">
                                    <TextBlock Text="{Binding Tickets.Count}" Foreground="White" FontSize="8" FontWeight="Bold" 
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Chip hồ sơ Quản trị viên IT -->
                        <StackPanel Orientation="Horizontal" Cursor="Hand" VerticalAlignment="Center">
                            <Border Width="36" Height="36" CornerRadius="18" Background="#2563eb" Margin="0,0,10,0">
                                <TextBlock Text="IT" FontWeight="Bold" Foreground="White" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                <TextBlock Text="IT Support" FontWeight="Bold" FontSize="12" Foreground="#0f172a"/>
                                <TextBlock Text="Administrator" FontSize="10" Foreground="#64748b"/>
                            </StackPanel>
                            <ui:SymbolIcon Symbol="ChevronDown20" Foreground="#94a3b8" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 2.2 VÙNG CONTENT RENDER ĐỘNG NHƯ WEBSITE (KHÔNG MỞ CỬA SỔ MỚI) -->
            <ContentControl Grid.Row="1" Content="{Binding CurrentView}" Margin="20"/>
        </Grid>

        <!-- ================= 3. IN-APP MODAL OVERLAY (CHUẨN WEB / SPA CAO CẤP) ================= -->
        <Grid x:Name="ModalBackdrop" Grid.Column="0" Grid.ColumnSpan="2" 
              Visibility="Collapsed" Panel.ZIndex="999" Background="#730f172a">
            <Border Width="420" Background="#ffffff" CornerRadius="16" 
                    BorderBrush="#e2e8f0" BorderThickness="1"
                    Padding="28,28,28,24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="36" ShadowDepth="6" Opacity="0.22" Color="#0f172a" Direction="270"/>
                </Border.Effect>
                <StackPanel HorizontalAlignment="Center">
                    <!-- Icon Tròn Phản Chiếu Loại Modal -->
                    <Border x:Name="ModalIconBg" Width="54" Height="54" CornerRadius="27" 
                            Background="#eff6ff" HorizontalAlignment="Center" Margin="0,0,0,16">
                        <Path x:Name="ModalIconPath" Width="24" Height="24" Stretch="Uniform" 
                              Fill="#2563eb" HorizontalAlignment="Center" VerticalAlignment="Center"
                              Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z"/>
                    </Border>

                    <!-- Tiêu Đề Modal -->
                    <TextBlock x:Name="ModalTitle" Text="Thông Báo" FontSize="16" FontWeight="Bold" 
                               Foreground="#0f172a" TextAlignment="Center" Margin="0,0,0,8"/>

                    <!-- Nội Dung Thông Báo -->
                    <TextBlock x:Name="ModalMessage" Text="Nội dung..." FontSize="13" 
                               Foreground="#64748b" TextWrapping="Wrap" TextAlignment="Center" 
                               LineHeight="20" Width="360" Margin="0,0,0,24"/>

                    <!-- Các Nút Hành Động -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="ModalBtnCancel" Width="140" Content="Hủy" 
                                Style="{StaticResource ModalCancelButtonStyle}" Margin="0,0,10,0" 
                                Click="ModalBtnCancel_Click"/>

                        <Button x:Name="ModalBtnConfirm" Width="140" Content="Xác nhận" 
                                Style="{StaticResource ModalConfirmButtonStyle}" 
                                Click="ModalBtnConfirm_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>