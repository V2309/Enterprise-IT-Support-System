<UserControl x:Class="DeskPilot.Admin.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Background="Transparent">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="ConvItemButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#f1f5f9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#e2e8f0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Khung chính chia 2 cột: Cột trái (Danh sách máy đang chat), Cột phải (Cửa sổ chat chi tiết) -->
    <Grid Margin="20,10,20,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="310"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= CỘT TRÁI: DANH SÁCH HỘI THOẠI ================= -->
        <Border Grid.Column="0" Background="#ffffff" CornerRadius="16" BorderBrush="#e2e8f0" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.04" Color="#0f172a" Direction="270"/>
            </Border.Effect>
            <Grid Margin="16,14,16,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Header + Nút làm mới -->
                    <RowDefinition Height="Auto"/> <!-- Ô tìm kiếm máy trạm -->
                    <RowDefinition Height="*"/>    <!-- Danh sách cuộc hội thoại cuộn -->
                </Grid.RowDefinitions>

                <!-- Header danh sách hội thoại -->
                <DockPanel Grid.Row="0" Margin="0,0,0,12">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="28" Height="28" CornerRadius="14" Background="#eff6ff" Margin="0,0,8,0">
                            <ui:SymbolIcon Symbol="Chat24" FontSize="15" Foreground="#2563eb" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Hộp thoại IT" FontSize="15" FontWeight="Bold" Foreground="#0f172a" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Nút Tải lại danh sách -->
                    <Button DockPanel.Dock="Right" Cursor="Hand" Background="Transparent" BorderThickness="0" Padding="4"
                            Click="BtnRefreshConversations_Click" ToolTip="Làm mới danh sách hội thoại">
                        <ui:SymbolIcon Symbol="ArrowSync24" FontSize="16" Foreground="#64748b"/>
                    </Button>
                </DockPanel>

                <!-- Ô tìm kiếm máy trạm -->
                <Border Grid.Row="1" Background="#f8fafc" BorderBrush="#e2e8f0" BorderThickness="1" CornerRadius="8" Padding="8,4" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Grid.Column="0" Symbol="Search24" FontSize="14" Foreground="#94a3b8" Margin="2,0,6,0" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" x:Name="TxtSearchConv" FontSize="12.5" Foreground="#0f172a"
                                 Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center"
                                 TextChanged="TxtSearchConv_TextChanged"/>
                        <TextBlock Grid.Column="1" x:Name="TxtSearchPlaceholder" Text="Tìm theo tên máy, nhân viên..."
                                   FontSize="12" Foreground="#94a3b8" VerticalAlignment="Center" Margin="2,0,0,0" IsHitTestVisible="False"/>
                    </Grid>
                </Border>

                <!-- Danh sách các cuộc hội thoại -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="ConversationsItemsControl" ItemsSource="{Binding ChatConversations}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource ConvItemButtonStyle}" Click="ConversationItem_Click" Tag="{Binding MachineName}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Avatar / Icon máy tính + chấm online -->
                                        <Grid Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center">
                                            <Border Width="38" Height="38" CornerRadius="10" Background="#f1f5f9">
                                                <ui:SymbolIcon Symbol="Desktop24" FontSize="18" Foreground="#475569" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <!-- Chấm online/offline -->
                                            <Border Width="10" Height="10" CornerRadius="5" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                    Margin="0,0,-2,-2" BorderBrush="#ffffff" BorderThickness="1.5">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#ef4444"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                                <Setter Property="Background" Value="#10b981"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                        </Grid>

                                        <!-- Tên máy + Tin nhắn cuối -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding MachineName}" FontSize="13" FontWeight="Bold" Foreground="#0f172a"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock FontSize="11" Foreground="#64748b" Margin="0,1,0,0">
                                                <Run Text="{Binding UserName, TargetNullValue='Nhân viên'}"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding LastMessage}" FontSize="11.5" Foreground="#94a3b8" Margin="0,2,0,0"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="170"/>
                                        </StackPanel>

                                        <!-- Giờ gửi tin cuối + Badge số tin chưa đọc -->
                                        <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding TimeDisplay}" FontSize="10.5" Foreground="#94a3b8" HorizontalAlignment="Right"/>
                                            <!-- Chấm đỏ số tin chưa đọc -->
                                            <Border MinWidth="18" Height="18" CornerRadius="9" Background="#ef4444" Padding="4,0"
                                                    HorizontalAlignment="Right" Margin="0,4,0,0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasUnread}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding UnreadCount}" Foreground="#ffffff" FontSize="10" FontWeight="Bold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ================= CỘT PHẢI: KHÔNG GIAN HỘI THOẠI CHI TIẾT ================= -->
        <Border Grid.Column="2" Background="#ffffff" CornerRadius="16" BorderBrush="#e2e8f0" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.04" Color="#0f172a" Direction="270"/>
            </Border.Effect>

            <Grid>
                <!-- Trạng thái khi ĐÃ CHỌN 1 MÁY ĐỂ CHAT -->
                <Grid x:Name="ActiveChatPanel" Visibility="{Binding HasSelectedConversation, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Top bar thông tin máy trạm -->
                        <RowDefinition Height="*"/>    <!-- Vùng tin nhắn cuộn -->
                        <RowDefinition Height="Auto"/> <!-- Khung nhập tin nhắn dính chân trang -->
                    </Grid.RowDefinitions>

                    <!-- Header máy trạm đang chat -->
                    <Border Grid.Row="0" Background="#f8fafc" BorderBrush="#e2e8f0" BorderThickness="0,0,0,1" CornerRadius="16,16,0,0" Padding="18,12">
                        <DockPanel LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="38" Height="38" CornerRadius="19" Background="#dbeafe" Margin="0,0,12,0">
                                    <ui:SymbolIcon Symbol="Desktop24" FontSize="18" Foreground="#2563eb" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SelectedConversation.MachineName}" FontSize="15" FontWeight="Bold" Foreground="#0f172a" Margin="0,0,8,0"/>
                                        <!-- Badge Online / Offline -->
                                        <Border CornerRadius="6" Padding="6,2">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#fee2e2"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedConversation.IsOnline}" Value="True">
                                                            <Setter Property="Background" Value="#dcfce7"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="10.5" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="Ngoại tuyến"/>
                                                        <Setter Property="Foreground" Value="#dc2626"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedConversation.IsOnline}" Value="True">
                                                                <Setter Property="Text" Value="Trực tuyến"/>
                                                                <Setter Property="Foreground" Value="#16a34a"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock FontSize="11.5" Foreground="#64748b" Margin="0,2,0,0">
                                        <Run Text="Nhân viên sử dụng: "/>
                                        <Run Text="{Binding SelectedConversation.UserName, TargetNullValue='Chưa xác định'}" FontWeight="SemiBold" Foreground="#334155"/>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>

                            <!-- Các phím tắt can thiệp nhanh ngay trong cuộc chat -->
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Click="BtnQuickSpooler_Click" Margin="0,0,8,0" Cursor="Hand" Background="#eff6ff" BorderBrush="#bfdbfe" BorderThickness="1" Padding="10,5">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="Print24" FontSize="13" Foreground="#2563eb" Margin="0,0,5,0"/>
                                        <TextBlock Text="Khởi động Spooler" FontSize="11.5" FontWeight="SemiBold" Foreground="#2563eb"/>
                                    </StackPanel>
                                </Button>
                                <Button Click="BtnQuickFlushDns_Click" Cursor="Hand" Background="#eff6ff" BorderBrush="#bfdbfe" BorderThickness="1" Padding="10,5">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="ArrowSync24" FontSize="13" Foreground="#2563eb" Margin="0,0,5,0"/>
                                        <TextBlock Text="Flush DNS" FontSize="11.5" FontWeight="SemiBold" Foreground="#2563eb"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Danh sách bong bóng tin nhắn chat -->
                    <ScrollViewer Grid.Row="1" x:Name="AdminChatScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="18,14,14,14">
                        <ItemsControl x:Name="MessagesItemsControl" ItemsSource="{Binding CurrentChatMessages}" Margin="0,0,16,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4,0,4">
                                        <!-- Tin nhắn của Admin (gửi đi): Căn Phải, màu tím/xanh gradient -->
                                        <!-- Tin nhắn của Nhân viên (nhận về): Căn Trái, nền xám/trắng viền bo -->
                                        <Border MaxWidth="520" Padding="14,10">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <!-- Mặc định: Tin nhắn của Nhân viên (Trái) -->
                                                    <Setter Property="HorizontalAlignment" Value="Left"/>
                                                    <Setter Property="CornerRadius" Value="14,14,14,2"/>
                                                    <Setter Property="Background" Value="#f1f5f9"/>
                                                    <Setter Property="BorderBrush" Value="#e2e8f0"/>
                                                    <Setter Property="BorderThickness" Value="1"/>

                                                    <!-- Trigger khi là Admin gửi (Phải) -->
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFromAdmin}" Value="True">
                                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                                            <Setter Property="CornerRadius" Value="14,14,2,14"/>
                                                            <Setter Property="Margin" Value="0,0,12,0"/>
                                                            <Setter Property="Background">
                                                                <Setter.Value>
                                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                        <GradientStop Color="#2563eb" Offset="0.0"/>
                                                                        <GradientStop Color="#4338ca" Offset="1.0"/>
                                                                    </LinearGradientBrush>
                                                                </Setter.Value>
                                                            </Setter>
                                                            <Setter Property="BorderThickness" Value="0"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>

                                            <StackPanel>
                                                <!-- Header: Tên người gửi + Giờ -->
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                    <TextBlock FontSize="10.5" FontWeight="Bold" Margin="0,0,8,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="{Binding SenderName}"/>
                                                                <Setter Property="Foreground" Value="#475569"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsFromAdmin}" Value="True">
                                                                        <Setter Property="Text" Value="IT Admin (Bạn)"/>
                                                                        <Setter Property="Foreground" Value="#bfdbfe"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>

                                                    <TextBlock Text="{Binding TimeDisplay}" FontSize="10">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#94a3b8"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsFromAdmin}" Value="True">
                                                                        <Setter Property="Foreground" Value="#bfdbfe"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>

                                                <!-- Ảnh đính kèm từ ImageKit (nếu có) -->
                                                <Border MaxWidth="380" MaxHeight="260" CornerRadius="8" ClipToBounds="True" Margin="0,4,0,6" Cursor="Hand" MouseLeftButtonDown="ChatImage_MouseLeftButtonDown" Tag="{Binding ImageUrl}">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ImageUrl}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding ImageUrl}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Image Source="{Binding ImageUrl}" Stretch="Uniform" ToolTip="Bấm để mở ảnh xem kích thước gốc"/>
                                                </Border>

                                                <!-- Nội dung tin nhắn -->
                                                <TextBlock Text="{Binding Message}" FontSize="13" TextWrapping="Wrap" LineHeight="19">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#0f172a"/>
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsFromAdmin}" Value="True">
                                                                    <Setter Property="Foreground" Value="#ffffff"/>
                                                                </DataTrigger>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding Message}" Value="[Hình ảnh]"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Khung soạn tin nhắn trả lời phía dưới (hỗ trợ Preview ảnh đính kèm trước khi gửi) -->
                    <Border Grid.Row="2" Background="#ffffff" BorderBrush="#e2e8f0" BorderThickness="0,1,0,0" CornerRadius="0,0,16,16" Padding="18,12">
                        <StackPanel>
                            <!-- Khung xem trước ảnh đính kèm trước khi bấm Gửi -->
                            <Border x:Name="AdminAttachmentPreviewPanel" Visibility="Collapsed" Background="#f1f5f9" BorderBrush="#cbd5e1" BorderThickness="1" CornerRadius="8" Padding="6" Margin="0,0,0,8" HorizontalAlignment="Left">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="48" Height="48" CornerRadius="6" ClipToBounds="True" Background="#e2e8f0">
                                        <Image x:Name="ImgAdminAttachmentThumbnail" Stretch="UniformToFill"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,16,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtAdminAttachmentName" Text="Ảnh đính kèm" FontSize="12" FontWeight="SemiBold" Foreground="#0f172a" MaxWidth="220" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="Sẵn sàng gửi kèm tin nhắn" FontSize="10.5" Foreground="#64748b" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Width="22" Height="22" Cursor="Hand" Click="BtnRemoveAdminAttachment_Click" ToolTip="Xóa ảnh này" VerticalAlignment="Top" Margin="0,2,2,0">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="b" Background="#94a3b8" CornerRadius="11" Width="22" Height="22">
                                                    <Path Width="9" Height="9" Stretch="Uniform" Fill="#ffffff" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="b" Property="Background" Value="#ef4444"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </Border>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" x:Name="AdminChatInputBorder" Background="#f8fafc" BorderBrush="#cbd5e1" BorderThickness="1" CornerRadius="10" Padding="12,6">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsKeyboardFocused, ElementName=TxtAdminChatInput}" Value="True">
                                                <Setter Property="BorderBrush" Value="#2563eb"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <TextBox x:Name="TxtAdminChatInput"
                                             FontSize="13" Foreground="#0f172a"
                                             Background="Transparent" BorderThickness="0"
                                             AcceptsReturn="True" TextWrapping="Wrap"
                                             MaxHeight="90" MinHeight="32"
                                             Padding="0,2,0,2"
                                             VerticalScrollBarVisibility="Auto"
                                             TextChanged="TxtAdminChatInput_TextChanged"
                                             KeyDown="TxtAdminChatInput_KeyDown"
                                             PreviewKeyDown="TxtAdminChatInput_PreviewKeyDown">
                                        <TextBox.Template>
                                            <ControlTemplate TargetType="TextBox">
                                                <ScrollViewer x:Name="PART_ContentHost" Margin="0" Padding="{TemplateBinding Padding}"/>
                                            </ControlTemplate>
                                        </TextBox.Template>
                                    </TextBox>
                                    <TextBlock x:Name="TxtAdminChatPlaceholder"
                                               Text="Gõ tin nhắn hỗ trợ kỹ thuật (nhấn Enter để gửi, Shift+Enter để xuống dòng)..."
                                               FontSize="12.5" Foreground="#94a3b8"
                                               VerticalAlignment="Center" Margin="2,0,0,0"
                                               IsHitTestVisible="False"/>
                                </Grid>
                            </Border>

                            <!-- Nút Tải ảnh lên ImageKit -->
                            <Button x:Name="BtnAdminAttachImage" Grid.Column="1" Margin="8,0,0,0" Width="40" Height="40" Cursor="Hand" Click="BtnAdminAttachImage_Click" ToolTip="Tải ảnh lên ImageKit">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="btnBorder" Background="#f1f5f9" BorderBrush="#cbd5e1" BorderThickness="1" CornerRadius="20" Width="40" Height="40">
                                            <Path Width="18" Height="18" Stretch="Uniform" Fill="#475569" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Data="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="btnBorder" Property="Background" Value="#e2e8f0"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="btnBorder" Property="Background" Value="#cbd5e1"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Nút Gửi tròn xanh dương với mũi tên trắng sang phải -->
                            <Button x:Name="BtnAdminSend" Grid.Column="2" Margin="8,0,0,0" Width="40" Height="40" Cursor="Hand" Click="BtnAdminSend_Click" ToolTip="Gửi tin nhắn">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="btnBorder" Background="#2563eb" CornerRadius="20" Width="40" Height="40">
                                            <!-- Mũi tên gửi màu trắng -->
                                            <Path Width="15" Height="15" Stretch="Uniform" Fill="#ffffff" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Data="M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="btnBorder" Property="Background" Value="#1d4ed8"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="btnBorder" Property="Background" Value="#1e40af"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Trạng thái khi CHƯA CHỌN MÁY NÀO -->
                <Grid x:Name="NoConversationSelectedPanel">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSelectedConversation}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="400">
                        <Border Width="64" Height="64" CornerRadius="32" Background="#eff6ff" HorizontalAlignment="Center" Margin="0,0,0,16">
                            <ui:SymbolIcon Symbol="ChatMultiple24" FontSize="32" Foreground="#2563eb" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Kênh hỗ trợ kỹ thuật trực tiếp" FontSize="18" FontWeight="Bold" Foreground="#0f172a" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="Chọn một máy trạm từ danh sách bên trái để bắt đầu hỗ trợ người dùng theo thời gian thực."
                                   FontSize="13" Foreground="#64748b" TextWrapping="Wrap" TextAlignment="Center" LineHeight="20"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
