<UserControl x:Class="DeskPilot.Admin.Views.ToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Background="Transparent">

    <UserControl.Resources>
        <Style x:Key="PrimaryActionBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#2563eb"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1d4ed8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1e40af"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OutlineActionBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#eff6ff"/>
            <Setter Property="Foreground" Value="#2563eb"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="#bfdbfe"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#dbeafe"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. HEADER & ACTIONS -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Quản Lý Công Cụ &amp; Script Kỹ Thuật (IT Tools)" FontSize="18" FontWeight="Bold" Foreground="#0f172a"/>
                <TextBlock Text="Cấu hình danh mục script tự động hóa, tiện ích xử lý sự cố từ xa cho IT Support" FontSize="12" Foreground="#64748b" Margin="0,2,0,0"/>
            </StackPanel>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="Làm mới" Style="{StaticResource OutlineActionBtnStyle}" Margin="0,0,8,0" Click="BtnRefresh_Click"/>
                <Button Content="+ Thêm công cụ" Style="{StaticResource PrimaryActionBtnStyle}" Click="BtnAddTool_Click"/>
            </StackPanel>
        </DockPanel>

        <!-- 2. BỘ LỌC TÌM KIẾM -->
        <Border Grid.Row="1" Background="#ffffff" CornerRadius="12" BorderBrush="#e2e8f0" BorderThickness="1" Padding="14,10" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.5*"/>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Search -->
                <Border Grid.Column="0" Background="#f8fafc" BorderBrush="#e2e8f0" BorderThickness="1" CornerRadius="8" Padding="10,0" Height="36" Margin="0,0,10,0">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="Search24" Foreground="#94a3b8" FontSize="14" Margin="0,0,8,0"/>
                        <TextBox x:Name="TxtSearch" Grid.Column="1" BorderThickness="0" Background="Transparent" Foreground="#0f172a" FontSize="12" VerticalContentAlignment="Center" ToolTip="Tìm theo mã công cụ, tên, mô tả, tác giả..."/>
                    </Grid>
                </Border>

                <!-- Lọc danh mục -->
                <ComboBox x:Name="CmbCategory" Grid.Column="1" Height="36" Margin="0,0,10,0" VerticalContentAlignment="Center" FontSize="12">
                    <ComboBoxItem Content="Tất cả danh mục" IsSelected="True"/>
                    <ComboBoxItem Content="System"/>
                    <ComboBoxItem Content="Network"/>
                    <ComboBoxItem Content="Printer"/>
                    <ComboBoxItem Content="Maintenance"/>
                    <ComboBoxItem Content="Security"/>
                    <ComboBoxItem Content="Diagnostic"/>
                    <ComboBoxItem Content="Other"/>
                </ComboBox>

                <!-- Lọc trạng thái kích hoạt -->
                <ComboBox x:Name="CmbStatus" Grid.Column="2" Height="36" Margin="0,0,10,0" VerticalContentAlignment="Center" FontSize="12">
                    <ComboBoxItem Content="Tất cả trạng thái" IsSelected="True"/>
                    <ComboBoxItem Content="Đang kích hoạt"/>
                    <ComboBoxItem Content="Đã vô hiệu hóa"/>
                </ComboBox>

                <!-- Nút Lọc -->
                <Button Grid.Column="3" Content="Lọc dữ liệu" Style="{StaticResource PrimaryActionBtnStyle}" Height="36" Click="BtnFilter_Click"/>
            </Grid>
        </Border>

        <!-- 3. DANH SÁCH CÔNG CỤ DATAGRID -->
        <Border Grid.Row="2" Background="#ffffff" CornerRadius="14" BorderBrush="#e2e8f0" BorderThickness="1" Padding="16">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.04" Color="#0f172a" Direction="270"/>
            </Border.Effect>

            <DataGrid ItemsSource="{Binding Tools}" AutoGenerateColumns="False" 
                      CanUserAddRows="False" IsReadOnly="True" Background="Transparent" 
                      BorderThickness="0" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                      HorizontalGridLinesBrush="#f1f5f9" RowBackground="#ffffff"
                      AlternatingRowBackground="#fafafa" RowHeight="54">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#f8fafc"/>
                        <Setter Property="Foreground" Value="#475569"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="Padding" Value="12,10"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#e2e8f0"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#eff6ff"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>

                <DataGrid.Columns>
                    <!-- Mã Lệnh -->
                    <DataGridTemplateColumn Header="Mã Lệnh" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="#f1f5f9" BorderBrush="#e2e8f0" BorderThickness="1" CornerRadius="6" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Code}" FontFamily="Consolas, Cascadia Code, Courier New" FontWeight="Bold" FontSize="11" Foreground="#0f172a"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Tên Công Cụ & Mô tả tóm tắt -->
                    <DataGridTemplateColumn Header="Tên Công Cụ / Tiện Ích" Width="2.2*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center" Margin="4,0">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5" Foreground="#0f172a"/>
                                    <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#64748b" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Danh Mục -->
                    <DataGridTemplateColumn Header="Phân Loại" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="#f0fdf4" BorderBrush="#bbf7d0" BorderThickness="1" CornerRadius="8" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CategoryDisplay}" FontSize="11" FontWeight="SemiBold" Foreground="#15803d"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Phiên Bản & Tác giả -->
                    <DataGridTemplateColumn Header="Phiên Bản &amp; Tác Giả" Width="1.2*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center" Margin="4,0">
                                    <TextBlock Text="{Binding Version, StringFormat='v{0}'}" FontSize="11.5" FontWeight="SemiBold" Foreground="#334155"/>
                                    <TextBlock Text="{Binding Author}" FontSize="11" Foreground="#94a3b8" Margin="0,1,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    
                    <!-- Trạng Thái (Pill Badge) -->
                    <DataGridTemplateColumn Header="Trạng Thái" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="12" Padding="10,4" HorizontalAlignment="Left" VerticalAlignment="Center"
                                        Background="{Binding StatusBgColor}" BorderBrush="{Binding StatusBorderColor}" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="6" Height="6" Fill="{Binding StatusDotColor}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding StatusDisplay}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding StatusFgColor}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Thao Tác -->
                    <DataGridTemplateColumn Header="Thao Tác" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Width="30" Height="30" Padding="0" Background="#f1f5f9" Foreground="#334155"
                                            BorderThickness="0" Margin="0,0,6,0" Cursor="Hand" Click="BtnEditRow_Click" ToolTip="Chỉnh sửa công cụ">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="7"/>
                                            </Style>
                                        </Button.Resources>
                                        <ui:SymbolIcon Symbol="Edit20" FontSize="14" Foreground="#475569" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Button>
                                    <Button Width="30" Height="30" Padding="0" Background="#fef2f2" Foreground="#ef4444"
                                            BorderThickness="0" Cursor="Hand" Click="BtnDeleteRow_Click" ToolTip="Xóa công cụ">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="7"/>
                                            </Style>
                                        </Button.Resources>
                                        <ui:SymbolIcon Symbol="Dismiss20" FontSize="13" Foreground="#ef4444" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- 4. MODAL DIALOG IN-APP THÊM/SỬA CÔNG CỤ -->
        <Grid x:Name="ToolModalBackdrop" Grid.Row="0" Grid.RowSpan="3" Visibility="Collapsed" Background="#800f172a" Panel.ZIndex="100">
            <Border Width="600" Background="#ffffff" CornerRadius="16" BorderBrush="#e2e8f0" BorderThickness="1" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="4" Opacity="0.2" Color="#0f172a"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock x:Name="TxtModalTitle" Text="Thêm Công Cụ Mới" FontSize="16" FontWeight="Bold" Foreground="#0f172a" Margin="0,0,0,18"/>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Mã công cụ / Code *" FontSize="12" Foreground="#475569" Margin="0,0,0,4"/>
                            <TextBox x:Name="ModalCode" Height="34" VerticalContentAlignment="Center" FontSize="12" Padding="8,0" ToolTip="Ví dụ: FLUSH-DNS, RESTART-SPOOLER"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="Tên công cụ *" FontSize="12" Foreground="#475569" Margin="0,0,0,4"/>
                            <TextBox x:Name="ModalName" Height="34" VerticalContentAlignment="Center" FontSize="12" Padding="8,0"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Danh mục" FontSize="12" Foreground="#475569" Margin="0,0,0,4"/>
                            <ComboBox x:Name="ModalCategory" Height="34" VerticalContentAlignment="Center" FontSize="12">
                                <ComboBoxItem Content="System" IsSelected="True"/>
                                <ComboBoxItem Content="Network"/>
                                <ComboBoxItem Content="Printer"/>
                                <ComboBoxItem Content="Maintenance"/>
                                <ComboBoxItem Content="Security"/>
                                <ComboBoxItem Content="Diagnostic"/>
                                <ComboBoxItem Content="Other"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="Phiên bản &amp; Tác giả" FontSize="12" Foreground="#475569" Margin="0,0,0,4"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="ModalVersion" Grid.Column="0" Height="34" VerticalContentAlignment="Center" FontSize="12" Padding="8,0" Text="1.0.0" Margin="0,0,4,0"/>
                                <TextBox x:Name="ModalAuthor" Grid.Column="1" Height="34" VerticalContentAlignment="Center" FontSize="12" Padding="8,0" Text="IT Admin" Margin="4,0,0,0"/>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="Mô tả chức năng" FontSize="12" Foreground="#475569" Margin="0,0,0,4"/>
                        <TextBox x:Name="ModalDescription" Height="46" TextWrapping="Wrap" AcceptsReturn="True" FontSize="12" Padding="8,6"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="Lệnh hoặc Script thực thi (PowerShell / CMD) *" FontSize="12" Foreground="#475569" Margin="0,0,0,4"/>
                        <TextBox x:Name="ModalCommand" Height="80" TextWrapping="Wrap" AcceptsReturn="True" FontFamily="Consolas, Courier New" FontSize="12" Padding="8,6" Background="#f8fafc"/>
                    </StackPanel>

                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Tham số mặc định (nếu có)" FontSize="12" Foreground="#475569" Margin="0,0,0,4"/>
                            <TextBox x:Name="ModalParams" Height="34" VerticalContentAlignment="Center" FontSize="12" Padding="8,0"/>
                        </StackPanel>

                        <CheckBox x:Name="ModalIsActive" Grid.Column="1" Content="Kích hoạt sẵn sàng dùng" IsChecked="True" VerticalAlignment="Bottom" Margin="8,0,0,8" FontSize="12"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Hủy bỏ" Style="{StaticResource OutlineActionBtnStyle}" Margin="0,0,10,0" Click="ModalBtnCancel_Click"/>
                        <Button Content="Lưu công cụ" Style="{StaticResource PrimaryActionBtnStyle}" Click="ModalBtnSave_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
