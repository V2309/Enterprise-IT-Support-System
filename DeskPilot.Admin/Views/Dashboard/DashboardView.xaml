<UserControl x:Class="DeskPilot.Admin.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Background="Transparent">

    <UserControl.Resources>
        <!-- Nút thao tác nhanh trên từng Card máy -->
        <Style x:Key="CardActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#eff6ff"/>
            <Setter Property="BorderBrush" Value="#bfdbfe"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#1d4ed8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#dbeafe"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#93c5fd"/>
                                <Setter Property="Foreground" Value="#1e40af"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#bfdbfe"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nút Xem Biểu Đồ Lịch Sử trên Card máy -->
        <Style x:Key="MetricsChartButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#eef2ff"/>
            <Setter Property="BorderBrush" Value="#c7d2fe"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#4f46e5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#e0e7ff"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#a5b4fc"/>
                                <Setter Property="Foreground" Value="#4338ca"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#c7d2fe"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nút Lọc Bộ Đo trong Modal Biểu Đồ -->
        <Style x:Key="ChartFilterTabButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#64748b"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#f1f5f9"/>
                                <Setter Property="Foreground" Value="#1e293b"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Thẻ thống kê đầu trang -->
        <Style x:Key="StatPillStyle" TargetType="Border">
            <Setter Property="Background" Value="#ffffff"/>
            <Setter Property="BorderBrush" Value="#e2e8f0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- ================= 1. KHUNG CHÍNH DASHBOARD (LUÔN SÁNG RÕ, KHÔNG BỊ LÀM TỐI) ================= -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header & Thống kê -->
                <RowDefinition Height="*"/>    <!-- Grid các card máy -->
            </Grid.RowDefinitions>

            <!-- Hàng 0: Header & Thống kê nhanh -->
            <DockPanel Grid.Row="0" Margin="0,0,0,16">
                <!-- Tiêu đề -->
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="Tổng quan hệ thống" FontSize="18" FontWeight="Bold" Foreground="#0f172a"/>
                    <TextBlock Text="{Binding SelectedDepartment, StringFormat='{}Dàn máy trạm - {0}'}" FontSize="12" Foreground="#64748b" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- 3 Thẻ thống kê nhanh: Online, Offline, Tổng máy -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- Online -->
                    <Border Style="{StaticResource StatPillStyle}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="#10b981" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding OnlineCount, StringFormat='{}{0} Online'}" FontWeight="Bold" Foreground="#0f172a" FontSize="12"/>
                        </StackPanel>
                    </Border>
                    <!-- Offline -->
                    <Border Style="{StaticResource StatPillStyle}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="#ef4444" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding OfflineCount, StringFormat='{}{0} Offline'}" FontWeight="Bold" Foreground="#0f172a" FontSize="12"/>
                        </StackPanel>
                    </Border>
                    <!-- Tổng số máy -->
                    <Border Style="{StaticResource StatPillStyle}" Margin="0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Desktop20" Foreground="#2563eb" FontSize="14" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding TotalMachinesCount, StringFormat='{}{0} Tổng số máy'}" FontWeight="Bold" Foreground="#0f172a" FontSize="12"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>

            <!-- Hàng 1: Danh sách Card máy tính cuộn mượt -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding FilteredMachines}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- Card Máy Tính Chuẩn Senior UI -->
                            <Border Width="315" Background="#ffffff" CornerRadius="16" 
                                    BorderBrush="#e2e8f0" BorderThickness="1" 
                                    Margin="0,0,16,16" Padding="16">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.05" Color="#0f172a" Direction="270"/>
                                </Border.Effect>

                                <StackPanel>
                                    <!-- Header Card: Icon + Tên máy + Huy hiệu Online/Offline -->
                                    <DockPanel Margin="0,0,0,8">
                                        <Border Width="38" Height="38" CornerRadius="10" Background="#eff6ff" BorderBrush="#dbeafe" BorderThickness="1" Margin="0,0,12,0" DockPanel.Dock="Left">
                                            <ui:SymbolIcon Symbol="Desktop20" Foreground="#2563eb" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding MachineName}" FontWeight="Bold" Foreground="#0f172a" FontSize="15"/>
                                            <TextBlock Text="{Binding UserName}" Foreground="#64748b" FontSize="11.5" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <!-- Huy hiệu trạng thái -->
                                        <Border DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Top" CornerRadius="12" Padding="9,3.5">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#ecfdf5"/>
                                                    <Setter Property="BorderBrush" Value="#d1fae5"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                                            <Setter Property="Background" Value="#fef2f2"/>
                                                            <Setter Property="BorderBrush" Value="#fee2e2"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse Width="6" Height="6" Margin="0,0,5,0" VerticalAlignment="Center">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="#10b981"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                                                    <Setter Property="Fill" Value="#ef4444"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock FontSize="10.5" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="Online"/>
                                                            <Setter Property="Foreground" Value="#059669"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                                                    <Setter Property="Text" Value="Offline"/>
                                                                    <Setter Property="Foreground" Value="#dc2626"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </DockPanel>

                                    <!-- 3 Thanh đo tài nguyên phần cứng -->
                                    <StackPanel Margin="0,8,0,12">
                                        <!-- 1. RAM -->
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="RAM" Foreground="#64748b" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding RamUsagePercent, StringFormat='{}{0}%'}" FontSize="12" FontWeight="Bold" Foreground="#0f172a" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Border Background="#f1f5f9" CornerRadius="3" Height="5" Margin="0,0,0,8">
                                            <ProgressBar Value="{Binding RamUsagePercent}" Height="5" BorderThickness="0" Background="Transparent" Foreground="#10b981"/>
                                        </Border>

                                        <!-- 2. CPU -->
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="CPU" Foreground="#64748b" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding CpuUsagePercent, StringFormat='{}{0}%'}" FontSize="12" FontWeight="Bold" Foreground="#0f172a" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Border Background="#f1f5f9" CornerRadius="3" Height="5" Margin="0,0,0,8">
                                            <ProgressBar Value="{Binding CpuUsagePercent}" Height="5" BorderThickness="0" Background="Transparent" Foreground="#2563eb"/>
                                        </Border>

                                        <!-- 3. Ổ C -->
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="Ổ C" Foreground="#64748b" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding FreeDiskSpaceGB, StringFormat='{}Trống {0} GB'}" FontSize="12" FontWeight="Bold" Foreground="#0f172a" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Border Background="#f1f5f9" CornerRadius="3" Height="5">
                                            <ProgressBar Value="{Binding FreeDiskSpaceGB}" Maximum="120" Height="5" BorderThickness="0" Background="Transparent" Foreground="#f59e0b"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- NÚT XEM BIỂU ĐỒ LỊCH SỬ BIẾN THIÊN (METRICS HISTORY) -->
                                    <Button Style="{StaticResource MetricsChartButtonStyle}" 
                                            Click="BtnViewMetricsHistory_Click" 
                                            Margin="0,0,0,10"
                                            ToolTip="Xem đồ thị đường (Line Chart) biến thiên mức sử dụng RAM và Ổ C theo thời gian">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Path Width="13" Height="13" Stretch="Uniform" Fill="#4f46e5" Margin="0,0,6,0" VerticalAlignment="Center"
                                                  Data="M3.5 18.49l6-6.01 4 4L22 6.92l-1.41-1.41-7.09 7.97-4-4L2 16.99z"/>
                                            <TextBlock Text="Biểu đồ lịch sử (RAM / Ổ C)" FontSize="11.5" FontWeight="SemiBold" Foreground="#4f46e5" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- 3 Nút thao tác nhanh dưới mỗi card -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Button Grid.Column="0" Content="Fix Spooler" Style="{StaticResource CardActionButtonStyle}" Click="BtnFixSpooler_Click" ToolTip="Khởi động lại tiến trình Print Spooler"/>
                                        <Button Grid.Column="2" Content="Flush DNS" Style="{StaticResource CardActionButtonStyle}" Click="BtnFlushDns_Click" ToolTip="Xóa bộ đệm cache DNS"/>
                                        <Button Grid.Column="4" Content="Remote" Style="{StaticResource CardActionButtonStyle}" Click="BtnRemoteShell_Click" ToolTip="Mở phiên điều khiển từ xa (Remote Shell)"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- ================= 2. MODAL BIỂU ĐỒ NỔI ĐÈ LÊN MÀN HÌNH (NỀN TRONG SUỐT, HOÀN TOÀN KHÔNG CÓ LỚP PHỦ ĐEN MỜ) ================= -->
        <Grid x:Name="MetricsModalBackdrop" Panel.ZIndex="999" Visibility="Collapsed" 
              Background="Transparent" MouseDown="Backdrop_MouseDown">
            <!-- Modal Card Nổi bật với đổ bóng mềm mại cao cấp -->
            <Border Width="920" MaxHeight="660" Background="#ffffff" CornerRadius="20"
                    BorderBrush="#cbd5e1" BorderThickness="1" Padding="26,22,26,22"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    MouseDown="ModalCard_MouseDown">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="48" ShadowDepth="10" Opacity="0.18" Color="#0f172a" Direction="270"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header + Close -->
                        <RowDefinition Height="Auto"/> <!-- 4 KPI Stat Cards -->
                        <RowDefinition Height="Auto"/> <!-- Filter Tabs + Legend -->
                        <RowDefinition Height="Auto"/> <!-- Canvas Line Chart -->
                        <RowDefinition Height="Auto"/> <!-- Recent Samples Log -->
                    </Grid.RowDefinitions>

                    <!-- Hàng 0: Header & Nút đóng ✕ -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,16">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="42" Height="42" CornerRadius="12" Margin="0,0,14,0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#4f46e5" Offset="0.0"/>
                                        <GradientStop Color="#10b981" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Path Width="20" Height="20" Stretch="Uniform" Fill="#ffffff" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Data="M3.5 18.49l6-6.01 4 4L22 6.92l-1.41-1.41-7.09 7.97-4-4L2 16.99z"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="TxtModalMachineName" Text="PC-KETOAN-01" FontSize="17" FontWeight="Bold" Foreground="#0f172a"/>
                                    <Border x:Name="ModalOnlineBadge" Background="#ecfdf5" BorderBrush="#d1fae5" BorderThickness="1" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtModalStatus" Text="Online" FontSize="11" FontWeight="SemiBold" Foreground="#059669"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock x:Name="TxtModalMachineSub" Text="Người dùng: Nguyễn Văn A • Lấy mẫu định kỳ theo thời gian thực" FontSize="12" Foreground="#64748b" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Nút đóng ✕ -->
                        <Button DockPanel.Dock="Right" ToolTip="Đóng biểu đồ" Width="32" Height="32" Cursor="Hand" Click="BtnCloseMetricsModal_Click" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="closeBdr" Background="#f1f5f9" CornerRadius="16">
                                        <Path Width="10" Height="10" Stretch="Uniform" Fill="#64748b" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="closeBdr" Property="Background" Value="#fee2e2"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DockPanel>

                    <!-- Hàng 1: 4 Thẻ KPI Tóm Tắt (RAM Hiện tại, Đỉnh RAM, RAM Trung bình, Ổ đĩa C) -->
                    <Grid Grid.Row="1" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- KPI 1: RAM Hiện tại -->
                        <Border Grid.Column="0" Background="#f8fafc" BorderBrush="#e2e8f0" BorderThickness="1" CornerRadius="12" Padding="14,10">
                            <StackPanel>
                                <TextBlock Text="RAM HIỆN TẠI" FontSize="10.5" FontWeight="SemiBold" Foreground="#64748b"/>
                                <TextBlock x:Name="TxtModalCurrentRam" Text="68.5%" FontSize="18" FontWeight="Bold" Foreground="#10b981" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- KPI 2: Đỉnh RAM (Peak) -->
                        <Border Grid.Column="2" Background="#f8fafc" BorderBrush="#e2e8f0" BorderThickness="1" CornerRadius="12" Padding="14,10">
                            <StackPanel>
                                <TextBlock Text="ĐỈNH RAM (PEAK)" FontSize="10.5" FontWeight="SemiBold" Foreground="#64748b"/>
                                <TextBlock x:Name="TxtModalPeakRam" Text="84.2%" FontSize="18" FontWeight="Bold" Foreground="#f59e0b" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- KPI 3: RAM Trung bình -->
                        <Border Grid.Column="4" Background="#f8fafc" BorderBrush="#e2e8f0" BorderThickness="1" CornerRadius="12" Padding="14,10">
                            <StackPanel>
                                <TextBlock Text="RAM TRUNG BÌNH" FontSize="10.5" FontWeight="SemiBold" Foreground="#64748b"/>
                                <TextBlock x:Name="TxtModalAvgRam" Text="61.4%" FontSize="18" FontWeight="Bold" Foreground="#0f172a" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- KPI 4: Dung lượng Ổ C -->
                        <Border Grid.Column="6" Background="#f8fafc" BorderBrush="#e2e8f0" BorderThickness="1" CornerRadius="12" Padding="14,10">
                            <StackPanel>
                                <TextBlock Text="DUNG LƯỢNG Ổ C" FontSize="10.5" FontWeight="SemiBold" Foreground="#64748b"/>
                                <TextBlock x:Name="TxtModalDiskStatus" Text="Trống 42.5 GB" FontSize="16" FontWeight="Bold" Foreground="#4f46e5" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Hàng 2: Bộ lọc Series (Tất cả / Chỉ RAM / Chỉ Ổ C) + Chú giải Legend -->
                    <DockPanel Grid.Row="2" Margin="0,0,0,10">
                        <!-- Bộ nút lọc bên trái -->
                        <Border DockPanel.Dock="Left" Background="#f1f5f9" CornerRadius="8" Padding="3">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="BtnFilterAll" Content="Tất cả (RAM &amp; Ổ C)" Style="{StaticResource ChartFilterTabButtonStyle}" Click="BtnFilterAll_Click"/>
                                <Button x:Name="BtnFilterRam" Content="Chỉ xem RAM (%)" Style="{StaticResource ChartFilterTabButtonStyle}" Click="BtnFilterRam_Click"/>
                                <Button x:Name="BtnFilterDisk" Content="Chỉ xem Ổ C (%)" Style="{StaticResource ChartFilterTabButtonStyle}" Click="BtnFilterDisk_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- Chú giải Legend bên phải -->
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- RAM legend -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                                <Border Width="16" Height="3" Background="#10b981" CornerRadius="1.5" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="RAM Usage (%)" FontSize="11.5" Foreground="#334155" FontWeight="Medium"/>
                            </StackPanel>
                            <!-- Disk legend -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                                <Border Width="16" Height="3" Background="#6366f1" CornerRadius="1.5" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Disk Usage (%)" FontSize="11.5" Foreground="#334155" FontWeight="Medium"/>
                            </StackPanel>
                            <!-- Alert Threshold legend -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="16" Height="1" BorderBrush="#ef4444" BorderThickness="1,0,0,0" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Ngưỡng đỏ 85%" FontSize="11.5" Foreground="#dc2626"/>
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>

                    <!-- Hàng 3: Canvas Line Chart Biến Thiên Thời Gian Thực -->
                    <Border Grid.Row="3" Background="#f8fafc" BorderBrush="#e2e8f0" BorderThickness="1" CornerRadius="14" Padding="12,10" Margin="0,0,0,14">
                        <Canvas x:Name="ChartCanvas" Height="220" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ClipToBounds="True" SizeChanged="ChartCanvas_SizeChanged"/>
                    </Border>

                    <!-- Hàng 4: 5 Mốc Đo Gần Nhất (Recent Samples Log) -->
                    <Border Grid.Row="4" Background="#ffffff" BorderBrush="#f1f5f9" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="CÁC MỐC ĐO GẦN NHẤT THEO THỜI GIAN THỰC (REAL-TIME SAMPLES)" FontSize="10" FontWeight="Bold" Foreground="#94a3b8" Margin="0,0,0,6"/>
                            <StackPanel x:Name="RecentSamplesStack"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
