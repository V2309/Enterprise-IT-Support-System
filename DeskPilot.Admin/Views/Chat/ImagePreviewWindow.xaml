<Window x:Class="DeskPilot.Admin.Views.Chat.ImagePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Xem hình ảnh"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#E0030712"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Topmost="True"
        ShowInTaskbar="False"
        KeyDown="Window_KeyDown"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Grid>
        <!-- Nút đóng ở góc trên bên phải màn hình -->
        <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,24,28,0" Width="40" Height="40" Cursor="Hand"
                Click="BtnClose_Click" ToolTip="Đóng (ESC)">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="#33ffffff" CornerRadius="20" Width="40" Height="40">
                        <Path Width="14" Height="14" Stretch="Uniform" Fill="#ffffff" HorizontalAlignment="Center" VerticalAlignment="Center"
                              Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#66ffffff"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#99ffffff"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <!-- Khung ảnh to ở chính giữa màn hình -->
        <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="#0f172a" CornerRadius="12" Padding="6"
                BorderBrush="#334155" BorderThickness="1"
                MouseLeftButtonDown="ImageCard_MouseLeftButtonDown">
            <Border.Effect>
                <DropShadowEffect BlurRadius="40" ShadowDepth="8" Opacity="0.7" Color="#000000"/>
            </Border.Effect>
            <Grid>
                <!-- Loading indicator -->
                <TextBlock x:Name="TxtLoading" Text="Đang tải hình ảnh..." Foreground="#94a3b8"
                           FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Margin="40,30"/>

                <!-- Ảnh to rõ nét giữa màn hình -->
                <Image x:Name="PreviewImage"
                       MaxWidth="1300" MaxHeight="850"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
            </Grid>
        </Border>

        <!-- Hướng dẫn đóng -->
        <TextBlock Text="Nhấn ESC hoặc bấm ra ngoài để đóng"
                   Foreground="#94a3b8" FontSize="13"
                   HorizontalAlignment="Center" VerticalAlignment="Bottom"
                   Margin="0,0,0,24" IsHitTestVisible="False"/>
    </Grid>
</Window>
