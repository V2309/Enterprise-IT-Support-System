<Window x:Class="DeskPilot.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        Title="DeskPilot - IT Support Agent" 
        Height="455" Width="740"
        Icon="pack://application:,,,/Assets/app.ico"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">

    <Window.Resources>
        <!-- Nút Báo Lỗi Nhanh -->
        <Style x:Key="QuickReportButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#ffffff"/>
            <Setter Property="BorderBrush" Value="#e2e8f0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#f0f7ff"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#bfdbfe"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#dbeafe"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nút Tự Chẩn Đoán & Sửa Nhanh -->
        <Style x:Key="AutoFixButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2563eb"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1d4ed8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1e40af"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nút tiêu đề góc trên bên phải -->
        <Style x:Key="WindowControlButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#f1f5f9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Khung chính bo góc nền sáng với viền mỏng và bóng đổ nhẹ -->
    <Border Background="#ffffff" CornerRadius="16" BorderBrush="#e2e8f0" BorderThickness="1"
            MouseLeftButtonDown="Window_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" ShadowDepth="5" Opacity="0.12" Color="#0f172a" Direction="270"/>
        </Border.Effect>

        <Grid Margin="18,14,18,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Header -->
                <RowDefinition Height="*"/>
                <!-- Main Body -->
            </Grid.RowDefinitions>

            <!-- Icon khay hệ thống (System Tray) -->
            <tb:TaskbarIcon x:Name="MyNotifyIcon"
                            ToolTipText="DeskPilot - IT Support Agent"
                            IconSource="pack://application:,,,/Assets/app.ico"
                            TrayMouseDoubleClick="MyNotifyIcon_TrayMouseDoubleClick">
                <tb:TaskbarIcon.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Mở cửa sổ trợ giúp" Click="MenuOpen_Click"/>
                        <Separator/>
                        <MenuItem Header="Thoát ứng dụng" Click="MenuExit_Click"/>
                    </ContextMenu>
                </tb:TaskbarIcon.ContextMenu>
            </tb:TaskbarIcon>

            <!-- 1. Header: Logo, Tên app, Khẩu hiệu & Các nút điều khiển -->
            <DockPanel Grid.Row="0" Margin="0,0,0,16">
                <!-- Bên trái: Logo + Tên App -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Assets/icon.png" 
                           Width="36" Height="36" 
                           Margin="0,0,10,0" 
                           VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="DeskPilot" FontWeight="Bold" FontSize="16" Foreground="#0f172a"/>
                        <TextBlock Text="Luôn bên bạn, mọi lúc, mọi nơi" FontSize="11" Foreground="#64748b" Margin="0,1,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Bên phải: Nút Chat với IT, Cài đặt, Thu nhỏ, Đóng -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- Nút Mở Khung Chat với IT kèm Chấm đỏ thông báo -->
                    <Grid Margin="0,0,8,0">
                        <Button x:Name="BtnToggleChat" Click="BtnToggleChat_Click" Cursor="Hand" ToolTip="Trò chuyện trực tiếp với IT Support">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="btnBorder" Background="#eff6ff" BorderBrush="#bfdbfe" BorderThickness="1" CornerRadius="8" Padding="10,5">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="Chat24" FontSize="14" Foreground="#2563eb" Margin="0,0,6,0"/>
                                            <TextBlock x:Name="TxtChatBtnLabel" Text="Chat với IT" FontSize="12" FontWeight="SemiBold" Foreground="#2563eb"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="btnBorder" Property="Background" Value="#dbeafe"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Border x:Name="BadgeNewMessage" Background="#ef4444" CornerRadius="5" Width="10" Height="10"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-3,-3,0"
                                BorderBrush="#ffffff" BorderThickness="1.5" Visibility="Collapsed" IsHitTestVisible="False"/>
                    </Grid>

                    <Button Style="{StaticResource WindowControlButtonStyle}" Click="SettingsButton_Click" ToolTip="Cài đặt" Margin="0,0,4,0">
                        <ui:SymbolIcon Symbol="Settings24" FontSize="17" Foreground="#64748b"/>
                    </Button>
                    <Button Style="{StaticResource WindowControlButtonStyle}" Click="CloseButton_Click" ToolTip="Ẩn xuống khay hệ thống" Margin="0,0,4,0">
                        <ui:SymbolIcon Symbol="Subtract20" FontSize="15" Foreground="#64748b"/>
                    </Button>
                    <Button Style="{StaticResource WindowControlButtonStyle}" Click="CloseButton_Click" ToolTip="Đóng">
                        <ui:SymbolIcon Symbol="Dismiss20" FontSize="15" Foreground="#64748b"/>
                    </Button>
                </StackPanel>
            </DockPanel>

            <!-- 2. Thân giao diện: Chuyển đổi giữa Dashboard và Khung Chat -->
            <Grid Grid.Row="1">
                <!-- 2.1 Dashboard chính: Chia 2 cột (Trái: System Health & Sửa lỗi, Phải: Báo lỗi nhanh) -->
                <Grid x:Name="MainDashboardView" Visibility="Visible">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.15*"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                <!-- CỘT TRÁI -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Khung System Health -->
                    <Border Grid.Row="0" Background="#ffffff" CornerRadius="12" BorderBrush="#f1f5f9" BorderThickness="1.5" Padding="14,12" Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Tiêu đề System Health -->
                            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                    <Border Width="26" Height="26" CornerRadius="13" Background="#dcfce7" Margin="0,0,8,0">
                                        <ui:SymbolIcon Symbol="Pulse24" Foreground="#10b981" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="System Health" FontWeight="Bold" FontSize="14" Foreground="#0f172a" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtOverallStatus" Text="● Hoạt động tốt" DockPanel.Dock="Right" 
                                           HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Foreground="#10b981" FontSize="11" FontWeight="SemiBold"/>
                            </DockPanel>

                            <!-- 3 Vòng tròn đo thông số: RAM, CPU, Ổ C -->
                            <Grid Grid.Row="1" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- 1. RAM -->
                                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                    <TextBlock Text="RAM" FontWeight="Bold" FontSize="11" Foreground="#475569" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                    <Grid Width="70" Height="70" HorizontalAlignment="Center">
                                        <Ellipse Width="56" Height="56" Stroke="#f1f5f9" StrokeThickness="7"/>
                                        <Path x:Name="ArcRam" Stroke="#10b981" StrokeThickness="7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        <TextBlock x:Name="TxtRamPercent" Text="42%" FontWeight="Bold" FontSize="13" Foreground="#0f172a" 
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock x:Name="TxtRamDetails" Text="5.1 / 12 GB" FontSize="11" Foreground="#64748b" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                </StackPanel>

                                <!-- 2. CPU -->
                                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                    <TextBlock Text="CPU" FontWeight="Bold" FontSize="11" Foreground="#475569" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                    <Grid Width="70" Height="70" HorizontalAlignment="Center">
                                        <Ellipse Width="56" Height="56" Stroke="#f1f5f9" StrokeThickness="7"/>
                                        <Path x:Name="ArcCpu" Stroke="#2563eb" StrokeThickness="7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        <TextBlock x:Name="TxtCpuPercent" Text="28%" FontWeight="Bold" FontSize="13" Foreground="#0f172a" 
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock x:Name="TxtCpuDetails" Text="28% / 100%" FontSize="11" Foreground="#64748b" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                </StackPanel>

                                <!-- 3. Ổ C -->
                                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                    <TextBlock Text="Ổ C:" FontWeight="Bold" FontSize="11" Foreground="#475569" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                    <Grid Width="70" Height="70" HorizontalAlignment="Center">
                                        <Ellipse Width="56" Height="56" Stroke="#f1f5f9" StrokeThickness="7"/>
                                        <Path x:Name="ArcDisk" Stroke="#f59e0b" StrokeThickness="7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        <TextBlock x:Name="TxtDiskPercent" Text="65%" FontWeight="Bold" FontSize="13" Foreground="#0f172a" 
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock x:Name="TxtDiskDetails" Text="78 / 120 GB" FontSize="11" Foreground="#64748b" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Khung Tự chẩn đoán & Sửa nhanh -->
                    <Button Grid.Row="1" Style="{StaticResource AutoFixButtonStyle}" Click="BtnAutoFix_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="Wand24" Foreground="White" FontSize="24" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Tự chẩn đoán &amp; Sửa nhanh" FontWeight="Bold" FontSize="14" Foreground="White"/>
                                <TextBlock Text="Kiểm tra và chạy Runbook tự động" FontSize="11" Foreground="#dbeafe" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Button>
                </Grid>

                <!-- CỘT PHẢI: Báo lỗi nhanh (1-Click) -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Tiêu đề Báo lỗi nhanh -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <ui:SymbolIcon Symbol="Warning24" Foreground="#ef4444" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Báo lỗi nhanh (1-Click)" FontWeight="Bold" FontSize="14" Foreground="#0f172a" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Danh sách nút báo lỗi 1-Click -->
                    <StackPanel Grid.Row="1">
                        <!-- 1. Kẹt máy in -->
                        <Button Style="{StaticResource QuickReportButtonStyle}" Click="BtnReportPrinter_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="32" Height="32" CornerRadius="8" Background="#eff6ff" Margin="0,0,10,0">
                                    <ui:SymbolIcon Symbol="Print24" Foreground="#2563eb" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Kẹt máy in" FontWeight="SemiBold" FontSize="13" Foreground="#0f172a"/>
                                    <TextBlock Text="Lỗi máy in, không in được" FontSize="11" Foreground="#64748b" Margin="0,1,0,0"/>
                                </StackPanel>
                                <ui:SymbolIcon Grid.Column="2" Symbol="ChevronRight20" Foreground="#94a3b8" FontSize="14" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <!-- 2. Mất mạng -->
                        <Button Style="{StaticResource QuickReportButtonStyle}" Click="BtnReportNetwork_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="32" Height="32" CornerRadius="8" Background="#eff6ff" Margin="0,0,10,0">
                                    <ui:SymbolIcon Symbol="Wifi124" Foreground="#2563eb" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Mất mạng" FontWeight="SemiBold" FontSize="13" Foreground="#0f172a"/>
                                    <TextBlock Text="Không có kết nối Internet" FontSize="11" Foreground="#64748b" Margin="0,1,0,0"/>
                                </StackPanel>
                                <ui:SymbolIcon Grid.Column="2" Symbol="ChevronRight20" Foreground="#94a3b8" FontSize="14" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <!-- 3. Máy chậm -->
                        <Button Style="{StaticResource QuickReportButtonStyle}" Click="BtnReportSlow_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="32" Height="32" CornerRadius="8" Background="#eff6ff" Margin="0,0,10,0">
                                    <ui:SymbolIcon Symbol="Timer24" Foreground="#2563eb" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Máy chậm" FontWeight="SemiBold" FontSize="13" Foreground="#0f172a"/>
                                    <TextBlock Text="Hiệu suất máy tính thấp" FontSize="11" Foreground="#64748b" Margin="0,1,0,0"/>
                                </StackPanel>
                                <ui:SymbolIcon Grid.Column="2" Symbol="ChevronRight20" Foreground="#94a3b8" FontSize="14" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <!-- 4. Ô nhập sự cố khác & Nút gửi -->
                        <Border Background="#f8fafc" BorderBrush="#e2e8f0" BorderThickness="1" CornerRadius="10" Padding="6,3" Margin="0,3,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" VerticalAlignment="Center">
                                    <TextBox x:Name="TxtTicketIssue" 
                                             MinHeight="32" 
                                             Padding="4,2" 
                                             Background="Transparent" 
                                             Foreground="#0f172a" 
                                             BorderThickness="0" 
                                             FontSize="12"
                                             VerticalContentAlignment="Center" 
                                             TextChanged="TxtTicketIssue_TextChanged"
                                             KeyDown="TxtTicketIssue_KeyDown">
                                        <TextBox.Template>
                                            <ControlTemplate TargetType="TextBox">
                                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Margin="0" Padding="{TemplateBinding Padding}"/>
                                            </ControlTemplate>
                                        </TextBox.Template>
                                    </TextBox>
                                    <TextBlock x:Name="TxtTicketPlaceholder" 
                                               Text="Mô tả sự cố khác nếu có..." 
                                               Foreground="#94a3b8" 
                                               FontSize="12" 
                                               Margin="10,0,0,0" 
                                               IsHitTestVisible="False" 
                                               VerticalAlignment="Center"/>
                                </Grid>
                                <Button Grid.Column="1" 
                                        Content="Gửi" 
                                        FontWeight="SemiBold" 
                                        FontSize="12"
                                        Height="30" 
                                        Padding="15,0" 
                                        Cursor="Hand"
                                        Click="BtnSendTicket_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="btnBorder" 
                                                    Background="#eff6ff" 
                                                    BorderBrush="#bfdbfe" 
                                                    BorderThickness="1" 
                                                    CornerRadius="7" 
                                                    Padding="{TemplateBinding Padding}">
                                                <TextBlock x:Name="btnText" 
                                                           Text="{TemplateBinding Content}" 
                                                           Foreground="#2563eb" 
                                                           FontWeight="SemiBold" 
                                                           HorizontalAlignment="Center" 
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <!-- Rê chuột vào: Nền đậm hơn, chữ đậm hơn -->
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="btnBorder" Property="Background" Value="#dbeafe"/>
                                                    <Setter TargetName="btnBorder" Property="BorderBrush" Value="#93c5fd"/>
                                                    <Setter TargetName="btnText" Property="Foreground" Value="#1d4ed8"/>
                                                </Trigger>
                                                <!-- Khi nhấn chuột: Đậm hẳn xuống -->
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="btnBorder" Property="Background" Value="#bfdbfe"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Footer: Thông tin máy tính & Người dùng -->
                    <DockPanel Grid.Row="2" Margin="0,6,0,0">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <ui:SymbolIcon Symbol="Desktop20" Foreground="#64748b" FontSize="14" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtMachineName" Text="PC-KETOAN-01" Foreground="#64748b" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                            <ui:SymbolIcon Symbol="Person20" Foreground="#64748b" FontSize="14" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtUserName" Text="Nguyễn Văn A" Foreground="#64748b" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </Grid>

            <!-- 2.2 Khung Chat trực tiếp với IT Support -->
            <Border x:Name="ChatOverlayView" Visibility="Collapsed" Background="#f8fafc" CornerRadius="12" BorderBrush="#e2e8f0" BorderThickness="1">
                <Grid Margin="14,10,14,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header chat: Back button + Title -->
                        <RowDefinition Height="*"/>    <!-- Danh sách tin nhắn cuộn -->
                        <RowDefinition Height="Auto"/> <!-- Khung nhập tin nhắn gửi IT -->
                    </Grid.RowDefinitions>

                    <!-- Header khung chat -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <Button DockPanel.Dock="Left" Click="BtnBackToDashboard_Click" Cursor="Hand" Background="Transparent" BorderThickness="0" Padding="0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="ArrowLeft24" FontSize="16" Foreground="#2563eb" Margin="0,0,6,0"/>
                                <TextBlock Text="Quay lại" FontSize="12" FontWeight="SemiBold" Foreground="#2563eb"/>
                            </StackPanel>
                        </Button>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="Kênh hỗ trợ kỹ thuật trực tiếp" FontWeight="Bold" FontSize="13" Foreground="#0f172a" HorizontalAlignment="Center"/>
                            <TextBlock Text="Kết nối bảo mật tới đội ngũ IT DeskPilot" FontSize="10.5" Foreground="#10b981" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Danh sách tin nhắn chat -->
                    <Border Grid.Row="1" Background="#ffffff" CornerRadius="10" BorderBrush="#e2e8f0" BorderThickness="1" Margin="0,0,0,10" Padding="12,10,6,10">
                        <ScrollViewer x:Name="ClientChatScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="ClientChatMessagesStack" Margin="0,0,20,0"/>
                        </ScrollViewer>
                    </Border>

                    <!-- Khung nhập tin nhắn phía dưới (hỗ trợ Preview ảnh đính kèm trước khi gửi) -->
                    <StackPanel Grid.Row="2">
                        <!-- Khung xem trước ảnh đính kèm trước khi bấm Gửi -->
                        <Border x:Name="ClientAttachmentPreviewPanel" Visibility="Collapsed" Background="#f1f5f9" BorderBrush="#cbd5e1" BorderThickness="1" CornerRadius="8" Padding="6" Margin="0,0,0,6" HorizontalAlignment="Left">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <!-- Thumbnail ảnh -->
                                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="6" ClipToBounds="True" Background="#e2e8f0">
                                    <Image x:Name="ImgClientAttachmentThumbnail" Stretch="UniformToFill"/>
                                </Border>
                                <!-- Thông tin ảnh -->
                                <StackPanel Grid.Column="1" Margin="8,0,12,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtClientAttachmentName" Text="Ảnh đính kèm" FontSize="11.5" FontWeight="SemiBold" Foreground="#0f172a" MaxWidth="160" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="Sẵn sàng gửi kèm tin nhắn" FontSize="10" Foreground="#64748b" Margin="0,1,0,0"/>
                                </StackPanel>
                                <!-- Nút X xóa ảnh khỏi preview -->
                                <Button Grid.Column="2" Width="20" Height="20" Cursor="Hand" Click="BtnRemoveClientAttachment_Click" ToolTip="Xóa ảnh này" VerticalAlignment="Top" Margin="0,2,2,0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="b" Background="#94a3b8" CornerRadius="10" Width="20" Height="20">
                                                <Path Width="8" Height="8" Stretch="Uniform" Fill="#ffffff" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="b" Property="Background" Value="#ef4444"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Hàng nhập tin nhắn + Các nút chức năng -->
                        <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" x:Name="ClientChatInputBorder" Background="#ffffff" BorderBrush="#cbd5e1" BorderThickness="1" CornerRadius="10" MinHeight="36" Padding="10,2">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsKeyboardFocused, ElementName=TxtClientChatInput}" Value="True">
                                            <Setter Property="BorderBrush" Value="#2563eb"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid VerticalAlignment="Center">
                                <TextBox x:Name="TxtClientChatInput"
                                         FontSize="12.5" Foreground="#0f172a"
                                         Background="Transparent" BorderThickness="0"
                                         VerticalContentAlignment="Center"
                                         MinHeight="30"
                                         Padding="2,2,2,2"
                                         TextChanged="TxtClientChatInput_TextChanged"
                                         KeyDown="TxtClientChatInput_KeyDown"
                                         PreviewKeyDown="TxtClientChatInput_PreviewKeyDown">
                                    <TextBox.Template>
                                        <ControlTemplate TargetType="TextBox">
                                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Margin="0" Padding="{TemplateBinding Padding}"/>
                                        </ControlTemplate>
                                    </TextBox.Template>
                                </TextBox>
                                <TextBlock x:Name="TxtClientChatPlaceholder"
                                           Text="Gõ tin nhắn gửi IT Support (nhấn Enter để gửi)..."
                                           FontSize="12" Foreground="#94a3b8"
                                           VerticalAlignment="Center" Margin="4,0,0,0"
                                           IsHitTestVisible="False"/>
                            </Grid>
                        </Border>

                        <!-- Nút Tải ảnh lên ImageKit -->
                        <Button x:Name="BtnAttachClientChatImage" Grid.Column="1" Margin="6,0,0,0" Width="36" Height="36" Cursor="Hand" Click="BtnAttachClientChatImage_Click" ToolTip="Tải ảnh lên ImageKit">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="btnBorder" Background="#f1f5f9" BorderBrush="#cbd5e1" BorderThickness="1" CornerRadius="18" Width="36" Height="36">
                                        <Path Width="16" Height="16" Stretch="Uniform" Fill="#475569" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Data="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="btnBorder" Property="Background" Value="#e2e8f0"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="btnBorder" Property="Background" Value="#cbd5e1"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Nút Gửi tròn xanh dương với icon mũi tên sang phải -->
                        <Button x:Name="BtnSendClientChat" Grid.Column="2" Margin="6,0,0,0" Width="36" Height="36" Cursor="Hand" Click="BtnSendClientChat_Click" ToolTip="Gửi tin nhắn">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="btnBorder" Background="#2563eb" CornerRadius="18" Width="36" Height="36">
                                        <!-- Mũi tên gửi màu trắng -->
                                        <Path Width="14" Height="14" Stretch="Uniform" Fill="#ffffff" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Data="M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="btnBorder" Property="Background" Value="#1d4ed8"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="btnBorder" Property="Background" Value="#1e40af"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </StackPanel>
                </Grid>
            </Border>
            </Grid>
        </Grid>
    </Border>
</Window>