<UserControl x:Class="DeskPilot.Admin.Views.DevicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Background="Transparent">

    <UserControl.Resources>
        <Style x:Key="PrimaryActionBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#2563eb"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1d4ed8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1e40af"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OutlineActionBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#eff6ff"/>
            <Setter Property="Foreground" Value="#2563eb"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="#bfdbfe"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#dbeafe"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. HEADER & ACTIONS -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Quản Lý Thiết Bị CNTT (IT Assets)" FontSize="18" FontWeight="Bold" Foreground="#0f172a"/>
                <TextBlock Text="Theo dõi tài sản phần cứng, phân bổ thiết bị theo phòng ban và trạng thái sử dụng" FontSize="12" Foreground="#64748b" Margin="0,2,0,0"/>
            </StackPanel>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="Làm mới" Style="{StaticResource OutlineActionBtnStyle}" Margin="0,0,8,0" Click="BtnRefresh_Click"/>
                <Button Content="+ Thêm thiết bị" Style="{StaticResource PrimaryActionBtnStyle}" Click="BtnAddDevice_Click"/>
            </StackPanel>
        </DockPanel>

        <!-- 2. BỘ LỌC TÌM KIẾM -->
        <Border Grid.Row="1" Background="#ffffff" CornerRadius="12" BorderBrush="#e2e8f0" BorderThickness="1" Padding="14,10" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Search -->
                <Border Grid.Column="0" Background="#f8fafc" BorderBrush="#e2e8f0" BorderThickness="1" CornerRadius="8" Padding="10,0" Height="36" Margin="0,0,10,0">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="Search24" Foreground="#94a3b8" FontSize="14" Margin="0,0,8,0"/>
                        <TextBox x:Name="TxtSearch" Grid.Column="1" BorderThickness="0" Background="Transparent" Foreground="#0f172a" FontSize="12" VerticalContentAlignment="Center" ToolTip="Tìm theo mã, tên, serial, người dùng, IP..."/>
                    </Grid>
                </Border>

                <!-- Lọc phòng ban -->
                <ComboBox x:Name="CmbDepartment" Grid.Column="1" Height="36" Margin="0,0,10,0" VerticalContentAlignment="Center" FontSize="12">
                    <ComboBoxItem Content="Tất cả phòng ban" IsSelected="True"/>
                    <ComboBoxItem Content="Kế toán"/>
                    <ComboBoxItem Content="Kinh doanh"/>
                    <ComboBoxItem Content="Kỹ thuật"/>
                    <ComboBoxItem Content="Nhân sự"/>
                    <ComboBoxItem Content="Marketing"/>
                    <ComboBoxItem Content="Ban giám đốc"/>
                </ComboBox>

                <!-- Lọc loại thiết bị -->
                <ComboBox x:Name="CmbType" Grid.Column="2" Height="36" Margin="0,0,10,0" VerticalContentAlignment="Center" FontSize="12">
                    <ComboBoxItem Content="Tất cả loại" IsSelected="True"/>
                    <ComboBoxItem Content="Computer"/>
                    <ComboBoxItem Content="Laptop"/>
                    <ComboBoxItem Content="Printer"/>
                    <ComboBoxItem Content="Monitor"/>
                    <ComboBoxItem Content="NetworkDevice"/>
                    <ComboBoxItem Content="Peripheral"/>
                    <ComboBoxItem Content="Server"/>
                    <ComboBoxItem Content="Other"/>
                </ComboBox>

                <!-- Lọc trạng thái -->
                <ComboBox x:Name="CmbStatus" Grid.Column="3" Height="36" Margin="0,0,10,0" VerticalContentAlignment="Center" FontSize="12">
                    <ComboBoxItem Content="Tất cả trạng thái" IsSelected="True"/>
                    <ComboBoxItem Content="InUse"/>
                    <ComboBoxItem Content="InStock"/>
                    <ComboBoxItem Content="Maintenance"/>
                    <ComboBoxItem Content="Broken"/>
                    <ComboBoxItem Content="Disposed"/>
                </ComboBox>

                <!-- Nút Lọc -->
                <Button Grid.Column="4" Content="Lọc dữ liệu" Style="{StaticResource PrimaryActionBtnStyle}" Height="36" Click="BtnFilter_Click"/>
            </Grid>
        </Border>

        <!-- 3. DANH SÁCH THIẾT BỊ DATAGRID -->
        <Border Grid.Row="2" Background="#ffffff" CornerRadius="14" BorderBrush="#e2e8f0" BorderThickness="1" Padding="16">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.04" Color="#0f172a" Direction="270"/>
            </Border.Effect>

            <DataGrid ItemsSource="{Binding Devices}" AutoGenerateColumns="False" 
                      CanUserAddRows="False" IsReadOnly="True" Background="Transparent" 
                      BorderThickness="0" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                      HorizontalGridLinesBrush="#f1f5f9" RowBackground="#ffffff"
                      AlternatingRowBackground="#fafbfc" RowHeight="54">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#f8fafc"/>
                        <Setter Property="Foreground" Value="#475569"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="Padding" Value="14,10"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#e2e8f0"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#f8fafc"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mã Thiết Bị" Binding="{Binding DeviceCode}" FontWeight="Bold" Width="120"/>

                    <!-- Tên thiết bị + Cấu hình tóm tắt -->
                    <DataGridTemplateColumn Header="Tên Thiết Bị &amp; Cấu Hình" Width="2*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center" Margin="8,0">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" Foreground="#0f172a" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Specifications, TargetNullValue='Chưa cập nhật cấu hình'}" FontSize="11" Foreground="#64748b" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Loại" Binding="{Binding DeviceTypeDisplay}" Width="120"/>

                    <DataGridTemplateColumn Header="Phòng Ban" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="#f1f5f9" BorderBrush="#e2e8f0" BorderThickness="1" CornerRadius="6" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Department, TargetNullValue='Chưa gán'}" FontSize="11" FontWeight="SemiBold" Foreground="#334155"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Người Dùng" Binding="{Binding AssignedTo, TargetNullValue='Chưa cấp phát'}" Width="130"/>
                    <DataGridTextColumn Header="Địa Chỉ IP" Binding="{Binding IpAddress, TargetNullValue='—'}" Width="110"/>

                    <!-- Trạng thái Pill Badge -->
                    <DataGridTemplateColumn Header="Trạng Thái" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding StatusBgColor}" BorderBrush="{Binding StatusBorderColor}" BorderThickness="1" CornerRadius="12" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="6" Height="6" Fill="{Binding StatusDotColor}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding StatusDisplay}" FontSize="11" FontWeight="Bold" Foreground="{Binding StatusFgColor}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Thao Tác" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Width="30" Height="30" Padding="0" Background="#f1f5f9" Foreground="#334155"
                                            BorderThickness="0" Margin="0,0,6,0" Cursor="Hand" Click="BtnEditRow_Click" ToolTip="Chỉnh sửa thiết bị">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="7"/>
                                            </Style>
                                        </Button.Resources>
                                        <ui:SymbolIcon Symbol="Edit20" FontSize="14" Foreground="#475569" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Button>
                                    <Button Width="30" Height="30" Padding="0" Background="#fef2f2" Foreground="#ef4444"
                                            BorderThickness="0" Cursor="Hand" Click="BtnDeleteRow_Click" ToolTip="Xóa thiết bị">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="7"/>
                                            </Style>
                                        </Button.Resources>
                                        <ui:SymbolIcon Symbol="Dismiss20" FontSize="13" Foreground="#ef4444" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- 4. MODAL DIALOG IN-APP THÊM/SỬA THIẾT BỊ -->
        <Grid x:Name="DeviceModalBackdrop" Grid.Row="0" Grid.RowSpan="3" Visibility="Collapsed" Background="#800f172a" Panel.ZIndex="100">
            <Border Width="560" Background="#ffffff" CornerRadius="16" BorderBrush="#e2e8f0" BorderThickness="1" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="4" Opacity="0.2" Color="#0f172a"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock x:Name="TxtModalTitle" Text="Thêm Thiết Bị Mới" FontSize="16" FontWeight="Bold" Foreground="#0f172a" Margin="0,0,0,18"/>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Mã thiết bị *" FontSize="12" Foreground="#475569" Margin="0,0,0,4"/>
                            <TextBox x:Name="ModalDeviceCode" Height="34" VerticalContentAlignment="Center" FontSize="12" Padding="8,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="Tên thiết bị *" FontSize="12" Foreground="#475569" Margin="0,0,0,4"/>
                            <TextBox x:Name="ModalName" Height="34" VerticalContentAlignment="Center" FontSize="12" Padding="8,0"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Loại thiết bị" FontSize="12" Foreground="#475569" Margin="0,0,0,4"/>
                            <ComboBox x:Name="ModalType" Height="34" VerticalContentAlignment="Center" FontSize="12">
                                <ComboBoxItem Content="Computer" IsSelected="True"/>
                                <ComboBoxItem Content="Laptop"/>
                                <ComboBoxItem Content="Printer"/>
                                <ComboBoxItem Content="Monitor"/>
                                <ComboBoxItem Content="NetworkDevice"/>
                                <ComboBoxItem Content="Peripheral"/>
                                <ComboBoxItem Content="Server"/>
                                <ComboBoxItem Content="Other"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="Phòng ban" FontSize="12" Foreground="#475569" Margin="0,0,0,4"/>
                            <ComboBox x:Name="ModalDepartment" Height="34" VerticalContentAlignment="Center" FontSize="12">
                                <ComboBoxItem Content="Kế toán" IsSelected="True"/>
                                <ComboBoxItem Content="Kinh doanh"/>
                                <ComboBoxItem Content="Kỹ thuật"/>
                                <ComboBoxItem Content="Nhân sự"/>
                                <ComboBoxItem Content="Marketing"/>
                                <ComboBoxItem Content="Ban giám đốc"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Người sử dụng" FontSize="12" Foreground="#475569" Margin="0,0,0,4"/>
                            <TextBox x:Name="ModalAssignedTo" Height="34" VerticalContentAlignment="Center" FontSize="12" Padding="8,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="Trạng thái" FontSize="12" Foreground="#475569" Margin="0,0,0,4"/>
                            <ComboBox x:Name="ModalStatus" Height="34" VerticalContentAlignment="Center" FontSize="12">
                                <ComboBoxItem Content="InUse" IsSelected="True"/>
                                <ComboBoxItem Content="InStock"/>
                                <ComboBoxItem Content="Maintenance"/>
                                <ComboBoxItem Content="Broken"/>
                                <ComboBoxItem Content="Disposed"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Số Serial" FontSize="12" Foreground="#475569" Margin="0,0,0,4"/>
                            <TextBox x:Name="ModalSerial" Height="34" VerticalContentAlignment="Center" FontSize="12" Padding="8,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="Địa chỉ IP" FontSize="12" Foreground="#475569" Margin="0,0,0,4"/>
                            <TextBox x:Name="ModalIp" Height="34" VerticalContentAlignment="Center" FontSize="12" Padding="8,0"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Margin="0,0,0,18">
                        <TextBlock Text="Cấu hình &amp; Ghi chú" FontSize="12" Foreground="#475569" Margin="0,0,0,4"/>
                        <TextBox x:Name="ModalSpecs" Height="54" TextWrapping="Wrap" AcceptsReturn="True" FontSize="12" Padding="8,6"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Hủy bỏ" Style="{StaticResource OutlineActionBtnStyle}" Margin="0,0,10,0" Click="ModalBtnCancel_Click"/>
                        <Button Content="Lưu thiết bị" Style="{StaticResource PrimaryActionBtnStyle}" Click="ModalBtnSave_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
