<UserControl x:Class="DeskPilot.Admin.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Background="Transparent">

    <UserControl.Resources>
        <!-- Nút thao tác nhanh trên từng Card máy -->
        <Style x:Key="CardActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#eff6ff"/>
            <Setter Property="BorderBrush" Value="#bfdbfe"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#1d4ed8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#dbeafe"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#93c5fd"/>
                                <Setter Property="Foreground" Value="#1e40af"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#bfdbfe"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Thẻ thống kê đầu trang -->
        <Style x:Key="StatPillStyle" TargetType="Border">
            <Setter Property="Background" Value="#ffffff"/>
            <Setter Property="BorderBrush" Value="#e2e8f0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Header & Thống kê -->
                <RowDefinition Height="*"/>
                <!-- Grid các card máy -->
            </Grid.RowDefinitions>

            <!-- Hàng 0: Header & Thống kê nhanh -->
            <DockPanel Grid.Row="0" Margin="0,0,0,16">
                <!-- Tiêu đề -->
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="Tổng quan hệ thống" FontSize="18" FontWeight="Bold" Foreground="#0f172a"/>
                    <TextBlock Text="{Binding SelectedDepartment, StringFormat='{}Dàn máy trạm - {0}'}" FontSize="12" Foreground="#64748b" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- 3 Thẻ thống kê nhanh: Online, Offline, Tổng máy -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- Online -->
                    <Border Style="{StaticResource StatPillStyle}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="#10b981" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding OnlineCount, StringFormat='{}{0} Online'}" FontWeight="Bold" Foreground="#0f172a" FontSize="12"/>
                        </StackPanel>
                    </Border>
                    <!-- Offline -->
                    <Border Style="{StaticResource StatPillStyle}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="#ef4444" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding OfflineCount, StringFormat='{}{0} Offline'}" FontWeight="Bold" Foreground="#0f172a" FontSize="12"/>
                        </StackPanel>
                    </Border>
                    <!-- Tổng số máy -->
                    <Border Style="{StaticResource StatPillStyle}" Margin="0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Desktop20" Foreground="#2563eb" FontSize="14" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding TotalMachinesCount, StringFormat='{}{0} Tổng số máy'}" FontWeight="Bold" Foreground="#0f172a" FontSize="12"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>

            <!-- Hàng 1: Danh sách Card máy tính cuộn mượt -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding FilteredMachines}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- Card Máy Tính Chuẩn Senior UI -->
                            <Border Width="315" Background="#ffffff" CornerRadius="16" 
                                    BorderBrush="#e2e8f0" BorderThickness="1" 
                                    Margin="0,0,16,16" Padding="16">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.05" Color="#0f172a" Direction="270"/>
                                </Border.Effect>

                                <StackPanel>
                                    <!-- Header Card: Icon + Tên máy + Huy hiệu Online/Offline -->
                                    <DockPanel Margin="0,0,0,8">
                                        <Border Width="38" Height="38" CornerRadius="10" Background="#eff6ff" BorderBrush="#dbeafe" BorderThickness="1" Margin="0,0,12,0" DockPanel.Dock="Left">
                                            <ui:SymbolIcon Symbol="Desktop20" Foreground="#2563eb" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding MachineName}" FontWeight="Bold" Foreground="#0f172a" FontSize="15"/>
                                            <TextBlock Text="{Binding UserName}" Foreground="#64748b" FontSize="11.5" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <!-- Huy hiệu trạng thái -->
                                        <Border DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Top" CornerRadius="12" Padding="9,3.5">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#ecfdf5"/>
                                                    <Setter Property="BorderBrush" Value="#d1fae5"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                                            <Setter Property="Background" Value="#fef2f2"/>
                                                            <Setter Property="BorderBrush" Value="#fee2e2"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse Width="6" Height="6" Margin="0,0,5,0" VerticalAlignment="Center">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="#10b981"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                                                    <Setter Property="Fill" Value="#ef4444"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock FontSize="10.5" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="Online"/>
                                                            <Setter Property="Foreground" Value="#059669"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                                                    <Setter Property="Text" Value="Offline"/>
                                                                    <Setter Property="Foreground" Value="#dc2626"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </DockPanel>

                                    <!-- 3 Thanh đo tài nguyên phần cứng (Thiết kế thoáng đãng, số liệu phân tách rõ ràng) -->
                                    <StackPanel Margin="0,10,0,16">
                                        <!-- 1. RAM -->
                                        <Grid Margin="0,0,0,5">
                                            <TextBlock Text="RAM" Foreground="#64748b" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding RamUsagePercent, StringFormat='{}{0}%'}" FontSize="12.5" FontWeight="Bold" Foreground="#0f172a" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Border Background="#f1f5f9" CornerRadius="3" Height="6" Margin="0,0,0,10">
                                            <ProgressBar Value="{Binding RamUsagePercent}" Height="6" BorderThickness="0" Background="Transparent" Foreground="#10b981"/>
                                        </Border>

                                        <!-- 2. CPU -->
                                        <Grid Margin="0,0,0,5">
                                            <TextBlock Text="CPU" Foreground="#64748b" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding CpuUsagePercent, StringFormat='{}{0}%'}" FontSize="12.5" FontWeight="Bold" Foreground="#0f172a" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Border Background="#f1f5f9" CornerRadius="3" Height="6" Margin="0,0,0,10">
                                            <ProgressBar Value="{Binding CpuUsagePercent}" Height="6" BorderThickness="0" Background="Transparent" Foreground="#2563eb"/>
                                        </Border>

                                        <!-- 3. Ổ C -->
                                        <Grid Margin="0,0,0,5">
                                            <TextBlock Text="Ổ C" Foreground="#64748b" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding FreeDiskSpaceGB, StringFormat='{}Trống {0} GB'}" FontSize="12" FontWeight="Bold" Foreground="#0f172a" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Border Background="#f1f5f9" CornerRadius="3" Height="6">
                                            <ProgressBar Value="{Binding FreeDiskSpaceGB}" Maximum="120" Height="6" BorderThickness="0" Background="Transparent" Foreground="#f59e0b"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- 3 Nút thao tác nhanh dưới mỗi card (Rộng rãi, sắc nét, không bị khuất chữ) -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Button Grid.Column="0" Content="Fix Spooler" Style="{StaticResource CardActionButtonStyle}" Click="BtnFixSpooler_Click" ToolTip="Khởi động lại tiến trình Print Spooler"/>
                                        <Button Grid.Column="2" Content="Flush DNS" Style="{StaticResource CardActionButtonStyle}" Click="BtnFlushDns_Click" ToolTip="Xóa bộ đệm cache DNS"/>
                                        <Button Grid.Column="4" Content="Remote" Style="{StaticResource CardActionButtonStyle}" Click="BtnRemoteShell_Click" ToolTip="Mở phiên điều khiển từ xa (Remote Shell)"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
    </Grid>
</UserControl>
